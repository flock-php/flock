<UserControl
    x:Class="Flock.Tray.Settings.SiteDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Flock.Tray.Settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Settings/DetailStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- The selected site (SiteDetailViewModel): its address, then Site, Share, Versions and Server sections of labelled settings. -->
    <Border Style="{StaticResource DetailCardStyle}" Visibility="{Binding IsShown, Converter={StaticResource BooleanVisibilityConverter}}">
        <StackPanel Spacing="20">
            <!-- Header: name, address and folder, and the site's actions. -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource DetailTitleStyle}" VerticalAlignment="Center" />
                        <Border Style="{StaticResource NeutralBadgeStyle}" Visibility="{Binding IsProjectFolder, Converter={StaticResource BooleanVisibilityConverter}}">
                            <TextBlock Text="Project folder" Style="{StaticResource NeutralBadgeTextStyle}" />
                        </Border>
                    </StackPanel>
                    <HyperlinkButton Content="{Binding Url}" Command="{Binding OpenCommand}" Padding="0"
                                     Visibility="{Binding HasUrl, Converter={StaticResource BooleanVisibilityConverter}}" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource DetailNoteLineStyle}" ToolTipService.ToolTip="{Binding Path}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Command="{Binding OpenCommand}" IsEnabled="{Binding HasUrl}" Padding="8,6,8,6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" ToolTipService.ToolTip="{Binding OpenLabel}" AutomationProperties.Name="{Binding OpenLabel}">
                        <FontIcon Glyph="{StaticResource GlyphOpen}" Style="{StaticResource IconStyle}" />
                    </Button>
                    <Button Command="{Binding RevealCommand}" Padding="8,6,8,6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" ToolTipService.ToolTip="Show in Explorer" AutomationProperties.Name="Show in Explorer">
                        <FontIcon Glyph="{StaticResource GlyphFolder}" Style="{StaticResource IconStyle}" />
                    </Button>
                    <Button Command="{Binding ShowExtensionsCommand}" Padding="8,6,8,6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" ToolTipService.ToolTip="PHP extensions" AutomationProperties.Name="PHP extensions"
                            Visibility="{Binding IsPhp, Converter={StaticResource BooleanVisibilityConverter}}">
                        <FontIcon Glyph="{StaticResource GlyphPuzzle}" Style="{StaticResource IconStyle}" />
                    </Button>
                    <!-- Pin and unpin items appear only when there is something to pin or unpin. -->
                    <Button IsEnabled="{Binding HasMenu}" Padding="8,6,8,6" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Pin versions and the document root to the project"
                            AutomationProperties.Name="Pin versions and the document root to the project">
                        <FontIcon Glyph="{StaticResource GlyphMore}" Style="{StaticResource IconStyle}" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="{Binding PinPhpText}" Command="{Binding PinPhpCommand}"
                                                Visibility="{Binding ShowsPinPhp, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{Binding PinNodeText}" Command="{Binding PinNodeCommand}"
                                                Visibility="{Binding ShowsPinNode, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{Binding PinRootText}" Command="{Binding PinRootCommand}"
                                                Visibility="{Binding ShowsPinRoot, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <MenuFlyoutSeparator Visibility="{Binding ShowsMenuSeparator, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{Binding UnpinPhpText}" Command="{Binding UnpinPhpCommand}"
                                                Visibility="{Binding ShowsUnpinPhp, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <MenuFlyoutItem Text="{Binding UnpinNodeText}" Command="{Binding UnpinNodeCommand}"
                                                Visibility="{Binding ShowsUnpinNode, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <MenuFlyoutItem Text="Unpin Document Root (.flockrc)…" Command="{Binding UnpinRootCommand}"
                                                Visibility="{Binding ShowsUnpinRoot, Converter={StaticResource BooleanVisibilityConverter}}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Command="{Binding RemoveCommand}" Padding="8,6,8,6" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" ToolTipService.ToolTip="Remove site" AutomationProperties.Name="Remove site"
                            Visibility="{Binding CanRemove, Converter={StaticResource BooleanVisibilityConverter}}">
                        <FontIcon Glyph="{StaticResource GlyphDelete}" Style="{StaticResource IconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
            <settings:DetailWarning Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource StringVisibilityConverter}}" />

            <!-- Site: its type, HTTPS, the domains besides its own and (not for a Node.js app, served by its dev server) the document root. -->
            <StackPanel Style="{StaticResource DetailSectionStyle}">
                <TextBlock Text="Site" Style="{StaticResource DetailHeadingStyle}" />
                <settings:DetailField Label="Type">
                    <ComboBox MinWidth="140" SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" AutomationProperties.Name="Type">
                        <ComboBoxItem Content="PHP" />
                        <ComboBoxItem Content="Node.js" />
                    </ComboBox>
                </settings:DetailField>
                <settings:DetailField Label="HTTPS">
                    <ToggleSwitch IsOn="{Binding Secured, Mode=TwoWay}" MinWidth="0" AutomationProperties.Name="HTTPS" />
                </settings:DetailField>
                <settings:DetailField Label="Domains" LabelAlignment="Top">
                    <StackPanel Spacing="2">
                        <ItemsControl ItemsSource="{Binding Domains}" Visibility="{Binding HasDomains, Converter={StaticResource BooleanVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <settings:DetailWarning Text="{Binding Problem}"
                                                                Visibility="{Binding HasProblem, Converter={StaticResource BooleanVisibilityConverter}}" />
                                        <HyperlinkButton Content="{Binding LinkText}" Command="{Binding OpenCommand}" Padding="0"
                                                         ToolTipService.ToolTip="{Binding LinkTooltip}"
                                                         Visibility="{Binding IsLink, Converter={StaticResource BooleanVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Host}" Style="{StaticResource DetailLineStyle}"
                                                   Visibility="{Binding IsText, Converter={StaticResource BooleanVisibilityConverter}}" />
                                        <Button Grid.Column="1" Command="{Binding RemoveCommand}" Padding="4" Background="Transparent" BorderThickness="0"
                                                ToolTipService.ToolTip="{Binding RemoveLabel}" AutomationProperties.Name="{Binding RemoveLabel}">
                                            <FontIcon Glyph="{StaticResource GlyphRemove}" Style="{StaticResource IconStyle}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <HyperlinkButton Content="Add Domain…" Command="{Binding AddDomainCommand}" Padding="0" />
                    </StackPanel>
                </settings:DetailField>
                <TextBlock Text="{Binding WildcardNote}" Style="{StaticResource DetailCautionStyle}"
                           Visibility="{Binding ShowsWildcardNote, Converter={StaticResource BooleanVisibilityConverter}}" />
                <StackPanel Spacing="8" Visibility="{Binding IsPhp, Converter={StaticResource BooleanVisibilityConverter}}">
                    <settings:DetailField Label="Root">
                        <ComboBox MinWidth="190" ItemsSource="{Binding RootItems}" SelectedIndex="{Binding RootIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Document root" ToolTipService.ToolTip="{Binding RootTooltip}" />
                    </settings:DetailField>
                    <ItemsControl ItemsSource="{Binding RootHints}" ItemTemplate="{StaticResource HintTemplate}"
                                  Visibility="{Binding HasRootHints, Converter={StaticResource BooleanVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="{Binding RootEmptyNote}" Style="{StaticResource DetailNoteStyle}"
                               Visibility="{Binding RootEmptyNote, Converter={StaticResource StringVisibilityConverter}}" />
                    <TextBlock Style="{StaticResource DetailNoteStyle}"
                               Text="The folder Flock serves the site from. One picked here applies on this machine only; pin it (…) to write it into .flockrc for everyone." />
                </StackPanel>
            </StackPanel>

            <settings:ShareSection DataContext="{Binding Share}" />

            <!-- Versions: PHP and Node.js, with what pins or isolates them (a Node.js app has no PHP). -->
            <StackPanel Style="{StaticResource DetailSectionStyle}">
                <TextBlock Text="Versions" Style="{StaticResource DetailHeadingStyle}" />
                <settings:DetailField Label="PHP" Visibility="{Binding IsPhp, Converter={StaticResource BooleanVisibilityConverter}}">
                    <ComboBox MinWidth="190" ItemsSource="{Binding Php.Items}" SelectedIndex="{Binding Php.SelectedIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="{Binding Php.Tooltip}" />
                </settings:DetailField>
                <settings:DetailField Label="Node.js">
                    <ComboBox MinWidth="190" ItemsSource="{Binding Node.Items}" SelectedIndex="{Binding Node.SelectedIndex, Mode=TwoWay}"
                              ToolTipService.ToolTip="{Binding Node.Tooltip}" />
                </settings:DetailField>
                <ItemsControl ItemsSource="{Binding VersionHints}" ItemTemplate="{StaticResource HintTemplate}"
                              Visibility="{Binding HasVersionHints, Converter={StaticResource BooleanVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding VersionsNote}" Style="{StaticResource DetailNoteStyle}" />
            </StackPanel>

            <!-- A PHP site: what serves it, Reverb and Laravel Boost; a Node.js app: its dev server. -->
            <StackPanel Spacing="20" Visibility="{Binding IsPhp, Converter={StaticResource BooleanVisibilityConverter}}">
                <settings:SiteServerSection DataContext="{Binding Server}" />
                <settings:ReverbSection DataContext="{Binding Reverb}" />
                <StackPanel Style="{StaticResource DetailSectionStyle}" Visibility="{Binding ShowsBoost, Converter={StaticResource BooleanVisibilityConverter}}">
                    <TextBlock Text="Laravel Boost" Style="{StaticResource DetailHeadingStyle}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding BoostText}" Style="{StaticResource DetailCaptionStyle}" />
                        <HyperlinkButton Content="{Binding BoostAction}" Command="{Binding AddBoostGuidelineCommand}" Padding="0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            <Grid Visibility="{Binding IsNode, Converter={StaticResource BooleanVisibilityConverter}}">
                <settings:DevServerSection DataContext="{Binding DevServer}" />
            </Grid>

            <!-- Last, so screenshots and the docs find it at the end of the details. -->
            <StackPanel Style="{StaticResource DetailSectionStyle}">
                <TextBlock Text="Worktrees" Style="{StaticResource DetailHeadingStyle}" />
                <ItemsControl ItemsSource="{Binding Worktrees}"
                              Visibility="{Binding HasNoWorktrees, Converter={StaticResource InverseBooleanVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <HyperlinkButton Content="{Binding Label}" Command="{Binding SelectCommand}" Padding="0" VerticalAlignment="Center"
                                                     ToolTipService.ToolTip="{Binding Path}" />
                                    <TextBlock Text="{Binding Domain}" Style="{StaticResource DetailNoteLineStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- Its setup, or its own database. -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                Visibility="{Binding IsBusy, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <ProgressRing Width="12" Height="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Step}" Style="{StaticResource DetailCaptionLineStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Setup failed" Style="{StaticResource DetailCaptionLineStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               Visibility="{Binding IsFailed, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Border Style="{StaticResource NeutralBadgeStyle}"
                                            Visibility="{Binding HasOwnDatabase, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <TextBlock Text="{Binding DatabaseLabel}" Style="{StaticResource NeutralBadgeTextStyle}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding WorktreesNote}" Style="{StaticResource DetailNoteStyle}"
                           Visibility="{Binding HasNoWorktrees, Converter={StaticResource BooleanVisibilityConverter}}" />
                <Button Command="{Binding NewWorktreeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{StaticResource GlyphAdd}" Style="{StaticResource IconStyle}" VerticalAlignment="Center" />
                        <TextBlock Text="New Worktree…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
