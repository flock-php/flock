<UserControl
    x:Class="Flock.Tray.Settings.NodePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:settings="using:Flock.Tray.Settings"
    xmlns:controls="using:Flock.Tray.Controls">
    <UserControl.Resources>
        <settings:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <settings:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="4">
        <Grid Margin="1,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Loc Key=Versions_Versions}" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding CheckedText}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Button Command="{Binding CheckCommand}">
                    <controls:BusyContent Text="{l:Loc Key=Versions_CheckNow}" BusyText="{l:Loc Key=Versions_Checking}" IsBusy="{Binding IsChecking}" />
                </Button>
            </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="240" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding IsDefault, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <TextBlock Text="{l:Loc Key=Versions_Default}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding NpmText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Visibility="{Binding NpmText, Converter={StaticResource StringVisibilityConverter}}" />
                                    <TextBlock Text="{Binding NpmLatestText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               Visibility="{Binding NpmLatestText, Converter={StaticResource StringVisibilityConverter}}" />
                                </StackPanel>
                                <controls:OperationProgress Text="{Binding JobProgressText}" IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                                                            Visibility="{Binding HasRunningJob, Converter={StaticResource BooleanVisibilityConverter}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="{l:Loc Key=Common_Install}" Command="{Binding InstallCommand}"
                                        Visibility="{Binding ShowPrimaryInstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <Button Content="{l:Loc Key=Common_Update}" Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallCommand}"
                                        Visibility="{Binding ShowPrimaryUpdate, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <Button Content="{l:Loc Key=Common_UninstallEllipsis}" Click="UninstallNode"
                                        Visibility="{Binding ShowPrimaryUninstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <Button Click="OpenNodeActions" Padding="8,6" ToolTipService.ToolTip="{l:Loc Key=Common_MoreActions}" automation:AutomationProperties.Name="{l:Loc Key=Common_MoreActions}"
                                        Visibility="{Binding HasMoreActions, Converter={StaticResource BooleanVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{l:Loc Key=Node_NoVersions}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibilityConverter}}" />
        <TextBlock Text="{Binding CheckErrorText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                   Visibility="{Binding CheckErrorText, Converter={StaticResource StringVisibilityConverter}}" />
        <TextBlock
            Text="{l:Loc Key=Node_Footnote}"
            Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="2,6,0,0" />
    </StackPanel>
</UserControl>