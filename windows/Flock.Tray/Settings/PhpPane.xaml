<UserControl
    x:Class="Flock.Tray.Settings.PhpPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:settings="using:Flock.Tray.Settings"
    xmlns:controls="using:Flock.Tray.Controls">
    <UserControl.Resources>
        <settings:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <settings:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="0">
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <Grid Margin="1,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PHP-CGI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding CheckedText}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Command="{Binding CheckCommand}">
                        <controls:BusyContent Text="{l:Loc Key=Versions_CheckNow}" BusyText="{l:Loc Key=Versions_Checking}" IsBusy="{Binding IsChecking}" />
                    </Button>
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Versions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding VersionText}" />
                                        <Border Style="{StaticResource BadgeStyle}"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="{l:Loc Key=Versions_Default}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}"
                                                Visibility="{Binding IsPrerelease, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="{l:Loc Key=Versions_Prerelease}" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}"
                                                Visibility="{Binding HasXdebug, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="Xdebug" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding WithdrawnText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsWithdrawn, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <TextBlock Text="{Binding JobErrorText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding JobErrorText, Converter={StaticResource StringVisibilityConverter}}" />
                                    <controls:OperationProgress Text="{Binding JobProgressText}" Value="{Binding JobProgress}"
                                                                IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                                                                Visibility="{Binding HasRunningJob, Converter={StaticResource BooleanVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{l:Loc Key=Common_Install}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryInstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_Update}" Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryUpdate, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_UninstallEllipsis}" Click="UninstallPhp"
                                            Visibility="{Binding ShowPrimaryUninstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_Cancel}" Command="{Binding CancelCommand}"
                                            Visibility="{Binding ShowPrimaryCancel, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_Retry}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryRetry, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Click="OpenPhpActions" Padding="8,6" ToolTipService.ToolTip="{l:Loc Key=Common_MoreActions}"
                                            automation:AutomationProperties.Name="{l:Loc Key=Common_MoreActions}"
                                            Visibility="{Binding HasMoreActions, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding CheckErrorText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Visibility="{Binding CheckErrorText, Converter={StaticResource StringVisibilityConverter}}" />
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{Binding FrankenPhpVisibility}">
            <Grid Margin="1,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="FrankenPHP" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding FrankenCheckedText}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                    <Button Command="{Binding FrankenCheckCommand}">
                        <controls:BusyContent Text="{l:Loc Key=Versions_CheckNow}" BusyText="{l:Loc Key=Versions_Checking}" IsBusy="{Binding IsFrankenChecking}" />
                    </Button>
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Builds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="240" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding ShowDetail, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <controls:OperationProgress Text="{Binding JobProgressText}" Value="{Binding JobProgress}"
                                                                IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                                                                Visibility="{Binding HasRunningJob, Converter={StaticResource BooleanVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{l:Loc Key=Common_Install}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryInstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_Update}" Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryUpdate, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_UninstallEllipsis}" Click="UninstallFrankenPhp"
                                            Visibility="{Binding ShowPrimaryUninstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_Cancel}" Command="{Binding CancelCommand}"
                                            Visibility="{Binding ShowPrimaryCancel, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="{l:Loc Key=Common_Retry}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryRetry, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Click="OpenFrankenPhpActions" Padding="8,6" ToolTipService.ToolTip="{l:Loc Key=Common_MoreActions}"
                                            automation:AutomationProperties.Name="{l:Loc Key=Common_MoreActions}"
                                            Visibility="{Binding HasMoreActions, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FrankenCheckErrorText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Visibility="{Binding FrankenCheckErrorText, Converter={StaticResource StringVisibilityConverter}}" />
        </StackPanel>
    </StackPanel>
</UserControl>