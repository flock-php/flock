<UserControl
    x:Class="Flock.Tray.Settings.GeneralPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Flock.Tray.Controls"
    xmlns:l="using:Flock.Tray">
    <StackPanel Spacing="0">
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="{l:Loc Key=General_Daemon}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=General_Status}" />
                    <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding StatusVisibility}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=General_Version}" /><TextBlock Grid.Column="1" Text="{Binding VersionText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding StatusVisibility}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=General_Process}" /><TextBlock Grid.Column="1" Text="{Binding ProcessText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{l:Loc Key=General_Restart}" />
                        <TextBlock Text="{l:Loc Key=General_RestartDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RestartCommand}">
                        <controls:BusyContent Text="{l:Loc Key=General_RestartDaemon}" BusyText="{l:Loc Key=General_Restarting}" IsBusy="{Binding IsRestarting}" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24" Visibility="{Binding ConfigVisibility}">
            <TextBlock Text="{l:Loc Key=General_Network}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="1">
                    <TextBlock Text="{l:Loc Key=General_Domain}" />
                    <TextBlock Text="{Binding DomainDescription}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DomainValue}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding PortsDescription}" Visibility="{Binding PortsVisibility}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24" Visibility="{Binding ConfigVisibility}">
            <TextBlock Text="{l:Loc Key=General_Data}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{l:Loc Key=General_Folder}" />
                        <TextBlock Text="{Binding Root}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{l:Loc Key=Common_ShowInExplorer}" Click="ShowRoot" />
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="{l:Loc Key=General_Startup}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{l:Loc Key=General_OpenAtSignIn}" />
                        <TextBlock Text="{l:Loc Key=General_OpenAtSignInDescription}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="Startup" Grid.Column="1" MinWidth="0" Toggled="StartupToggled" OnContent="" OffContent="" />
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel x:Name="LanguageHost" />
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="{l:Loc Key=General_Updates}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <StackPanel x:Name="UpdateHost" Spacing="4" />
            <Border Style="{StaticResource CardStyle}" Visibility="{Binding ConfigVisibility}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock Text="{l:Loc Key=General_Beta}" />
                        <TextBlock Text="{l:Loc Key=General_BetaDescription}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="Beta" Grid.Column="1" MinWidth="0" IsOn="{Binding IsBeta}" IsEnabled="{Binding BetaEnabled}" Toggled="BetaToggled" OnContent=""
                                  OffContent="" />
                </Grid>
            </Border>
            <TextBlock Text="{l:Loc Key=General_Experimental}"
                       Visibility="{Binding ExperimentalVisibility}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24" Visibility="{Binding ConfigVisibility}">
            <TextBlock Text="{l:Loc Key=General_ProjectFolders}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="NoParked" Text="{l:Loc Key=General_NoProjectFolders}" Visibility="Collapsed" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView x:Name="Parked" ItemsSource="{Binding Config.Parked}" SelectionChanged="ParkedSelectionChanged" SelectionMode="Single" MinHeight="60">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="AddParked" Content="{l:Loc Key=General_AddProjectFolders}" Click="AddParkedClicked" />
                        <Button x:Name="RemoveParked" Content="{l:Loc Key=Common_Remove}" Click="RemoveParkedClicked" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding ProjectFoldersDescription}"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>