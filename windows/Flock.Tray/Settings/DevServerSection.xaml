<UserControl
    x:Class="Flock.Tray.Settings.DevServerSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Flock.Tray.Settings">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Settings/DetailStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- A Node.js site's dev server (DevServerSectionViewModel): its state, Start, Stop and Restart, the command and its output. -->
    <StackPanel Style="{StaticResource DetailSectionStyle}">
        <TextBlock Text="Dev server" Style="{StaticResource DetailHeadingStyle}" />
        <TextBlock Text="Flock starts the dev server on the site's first visit." Style="{StaticResource DetailNoteStyle}"
                   Visibility="{Binding HasNoServer, Converter={StaticResource BooleanVisibilityConverter}}" />

        <StackPanel Spacing="8" Visibility="{Binding HasServer, Converter={StaticResource BooleanVisibilityConverter}}">
            <settings:DetailField Label="State" LabelAlignment="Top">
                <StackPanel Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding Tone, Converter={StaticResource ToneBrushConverter}}" />
                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource DetailTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Problem}" Style="{StaticResource DetailCautionStyle}"
                               Visibility="{Binding Problem, Converter={StaticResource StringVisibilityConverter}}" />
                </StackPanel>
            </settings:DetailField>
            <settings:DetailField Label="Command">
                <TextBlock Text="{Binding Command}" Style="{StaticResource DetailMonoStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </settings:DetailField>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Start" Command="{Binding StartServerCommand}"
                        Visibility="{Binding CanStart, Converter={StaticResource BooleanVisibilityConverter}}" />
                <Button Content="Stop" Command="{Binding StopServerCommand}"
                        Visibility="{Binding CanStop, Converter={StaticResource BooleanVisibilityConverter}}" />
                <Button Content="Restart" Command="{Binding RestartServerCommand}"
                        Visibility="{Binding CanRestart, Converter={StaticResource BooleanVisibilityConverter}}" />
            </StackPanel>
            <settings:OutputPanel DataContext="{Binding OutputPanel}" />
            <TextBlock Style="{StaticResource DetailNoteStyle}"
                       Text="Flock runs the project's dev script with its Node.js version when the site is visited, and stops it after 30 minutes without visits." />
        </StackPanel>
    </StackPanel>
</UserControl>
