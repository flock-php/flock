<UserControl
    x:Class="Flock.Tray.Settings.NewWorktreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray">
    <StackPanel Spacing="12">
        <TextBox x:Name="BranchBox" Header="{l:Loc Key=NewWorktree_Branch}" PlaceholderText="{l:Loc Key=NewWorktree_BranchPlaceholder}" TextChanged="BranchChanged" />
        <!-- Disabled until the branches are loaded. -->
        <ComboBox x:Name="FromBox" Header="{l:Loc Key=NewWorktree_StartFrom}" MinWidth="260" IsEnabled="False" />
        <StackPanel Spacing="4">
            <ComboBox x:Name="DatabaseBox" Header="{l:Loc Key=NewWorktree_Database}" MinWidth="200" />
            <TextBlock Text="{l:Loc Key=NewWorktree_DatabaseNote}"
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ExplanationText" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
