<UserControl
    x:Class="Flock.Tray.Settings.MailPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:settings="using:Flock.Tray.Settings">
    <UserControl.Resources>
        <settings:StatusBrushConverter x:Key="StatusBrushConverter" />
        <settings:RunningTextConverter x:Key="RunningTextConverter" />
        <settings:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="0">
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="{l:Loc Key=Mail_SmtpServer}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=Mail_Host}" /><TextBlock Grid.Column="1" Text="127.0.0.1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=Mail_Port}" /><TextBlock Grid.Column="1" Text="{Binding Port}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=General_Status}" />
                    <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding Running, Converter={StaticResource StatusBrushConverter}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Running, Converter={StaticResource RunningTextConverter}}" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="{l:Loc Key=Mail_EnvironmentVariables}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}" Padding="16,12,16,12">
                <Grid>
                    <Border Style="{StaticResource CodeBlockStyle}">
                        <TextBlock Text="{Binding Environment}" FontFamily="{StaticResource MonoFont}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                    </Border>
                    <Button Content="{l:Loc Key=Common_Copy}" Click="CopyEnvironment" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,4"
                            Visibility="{Binding Environment, Converter={StaticResource StringVisibilityConverter}}" />
                </Grid>
            </Border>
            <TextBlock Text="{l:Loc Key=Mail_UsernameInbox}" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Loc Key=Mail_Caught}" /><TextBlock Grid.Column="1" Text="{Binding Count}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <Grid Style="{StaticResource SettingRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{l:Loc Key=Mail_Open}" /><Button Grid.Column="1" Content="{l:Loc Key=Mail_Open}" Click="OpenMail" />
                </Grid>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>