<!--
    The pieces of the details of a site, worktree or proxy in Settings → Sites. Each detail control merges
    this dictionary, so its framework styles (BasedOn) are found once the app's resources are loaded.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Flock.Tray.Settings">
    <settings:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
    <settings:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
    <settings:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    <settings:ToneBrushConverter x:Key="ToneBrushConverter" />
    <settings:StatusBrushConverter x:Key="StatusBrushConverter" />

    <x:String x:Key="GlyphAdd">&#xE710;</x:String>
    <x:String x:Key="GlyphCopy">&#xE8C8;</x:String>
    <x:String x:Key="GlyphDelete">&#xE74D;</x:String>
    <x:String x:Key="GlyphFolder">&#xE8B7;</x:String>
    <x:String x:Key="GlyphInfo">&#xE946;</x:String>
    <x:String x:Key="GlyphMore">&#xE712;</x:String>
    <x:String x:Key="GlyphOpen">&#xE8A7;</x:String>
    <x:String x:Key="GlyphPuzzle">&#xEA86;</x:String>
    <x:String x:Key="GlyphRemove">&#xE738;</x:String>

    <!-- The card the details are in, and a section of it: a heading and its settings. -->
    <Style x:Key="DetailCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="20,16,16,20" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style x:Key="DetailSectionStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style x:Key="DetailHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="DetailTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Text: wrapping, or one line cut off with an ellipsis. -->
    <Style x:Key="DetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="DetailLineStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="DetailCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="DetailCaptionLineStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="DetailNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailCaptionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="DetailNoteLineStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailCaptionLineStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="DetailCautionStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailCaptionStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="DetailMonoStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsTextSelectionEnabled" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- An icon button's glyph; the buttons themselves are borderless (Background Transparent, BorderThickness 0,
         Padding 8,6), like the macOS app's .borderless buttons. -->
    <Style x:Key="IconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource SymbolsFont}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="NeutralBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="NeutralBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- A note that wraps, with an action under it (HintViewModel). -->
    <DataTemplate x:Key="HintTemplate">
        <StackPanel>
            <settings:DetailWarning Text="{Binding Text}" IsHint="True" />
            <HyperlinkButton Content="{Binding ActionText}" Command="{Binding RunCommand}" Padding="4,2,4,2" Margin="18,0,0,0"
                             Visibility="{Binding HasAction, Converter={StaticResource BooleanVisibilityConverter}}" />
        </StackPanel>
    </DataTemplate>

    <!-- A labelled setting: the label in a fixed column, so the controls line up. -->
    <Style TargetType="settings:DetailField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="settings:DetailField">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Label}" Style="{StaticResource DetailLineStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="{TemplateBinding LabelAlignment}" />
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
