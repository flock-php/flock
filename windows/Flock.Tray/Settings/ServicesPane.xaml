<UserControl
    x:Class="Flock.Tray.Settings.ServicesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:settings="using:Flock.Tray.Settings">
    <UserControl.Resources>
        <settings:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
        <settings:StatusBrushConverter x:Key="StatusBrushConverter" />
        <settings:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" /><ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="Filter" SelectionChanged="FilterChanged" ToolTipService.ToolTip="{l:Loc Key=Services_FilterTooltip}"
                         Margin="-4,-8,0,4">
                <SelectorBarItem Text="{l:Loc Key=Services_Installed}" />
                <SelectorBarItem Text="{l:Loc Key=Services_All}" />
            </SelectorBar>
            <ScrollViewer Grid.Row="1" x:Name="ListScroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding VisibleServiceGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="8" Margin="0,8,0,12">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ItemsControl ItemsSource="{Binding Services}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="ServiceSelected" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Style="{StaticResource StatusDotStyle}"
                                                             Fill="{Binding Running, Converter={StaticResource StatusBrushConverter}}" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{Binding ListDetail}"
                                                                   Visibility="{Binding ListDetail, Converter={StaticResource StringVisibilityConverter}}"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{l:Loc Key=Services_InstallEllipsis}" VerticalAlignment="Center"
                                                               Visibility="{Binding Installed, Converter={StaticResource InverseBooleanVisibilityConverter}}"
                                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <ScrollViewer Grid.Column="1" x:Name="DetailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="DetailHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</UserControl>