<UserControl
    x:Class="Flock.Tray.Settings.ServicesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Flock.Tray.Settings">
    <UserControl.Resources>
        <settings:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
        <settings:StatusBrushConverter x:Key="StatusBrushConverter" />
        <settings:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <Grid ColumnSpacing="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" /><ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <SelectorBar x:Name="Filter" SelectionChanged="FilterChanged" ToolTipService.ToolTip="Show every service Flock offers, or only installed ones"
                     Margin="-4,-8,0,0">
            <SelectorBarItem Text="All" />
            <SelectorBarItem Text="Installed" />
        </SelectorBar>
        <ScrollViewer Grid.Row="1" x:Name="ListScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding VisibleServiceGroups}" Margin="0,0,14,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="8" Margin="0,8,0,12">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{Binding Services}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="ServiceSelected" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Style="{StaticResource StatusDotStyle}"
                                                         Fill="{Binding Running, Converter={StaticResource StatusBrushConverter}}" />
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                    <TextBlock Text="{Binding ListDetail}"
                                                               Visibility="{Binding ListDetail, Converter={StaticResource StringVisibilityConverter}}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="Install…" VerticalAlignment="Center"
                                                           Visibility="{Binding Installed, Converter={StaticResource InverseBooleanVisibilityConverter}}"
                                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <ScrollViewer Grid.RowSpan="2" Grid.Column="1" x:Name="DetailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="DetailHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </ScrollViewer>
    </Grid>
</UserControl>
