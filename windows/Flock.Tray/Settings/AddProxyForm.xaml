<UserControl
    x:Class="Flock.Tray.Settings.AddProxyForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:Flock.Tray.Settings">
    <!-- A proxy's name and upstream. The placeholders say what the fields take, so the form fits the smallest window
         (with the commands open, it scrolls there). -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <TextBox x:Name="NameBox" Header="Name" />
            <TextBox x:Name="UpstreamBox" Header="Upstream" PlaceholderText="3000, host:port or URL" ToolTipService.ToolTip="A port means 127.0.0.1." />
            <!-- Optional, so collapsed: most proxies point at a server that runs anyway. -->
            <Expander Header="Commands (optional)" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <settings:ProxyCommandsForm x:Name="Commands" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
