<local:FlockWindow
    x:Class="Flock.Tray.DumpsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:local="using:Flock.Tray">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="WindowIcon" Width="16" Height="16" />
                <TextBlock x:Name="WindowCaption" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <Grid x:Name="WindowBody" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12" Padding="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="Search" Grid.Column="0" HorizontalAlignment="Left" PlaceholderText="{l:Loc Key=Dumps_SearchPlaceholder}" QueryIcon="Find" Width="280"
                                VerticalAlignment="Center" TextChanged="SearchChanged" />
                <CommandBar x:Name="Toolbar" Grid.Column="1" DefaultLabelPosition="Right" HorizontalAlignment="Right">
                    <AppBarToggleButton x:Name="Capture" Icon="Download" Label="{l:Loc Key=Dumps_CaptureDumps}" Click="CaptureClicked" />
                    <AppBarButton x:Name="CaptureKinds" Icon="Filter" Label="{l:Loc Key=Dumps_CaptureShort}" />
                    <AppBarToggleButton x:Name="LatestOnly" Icon="Clock" Label="{l:Loc Key=Dumps_LatestOnly}" Click="LatestOnlyClicked" />
                    <AppBarButton x:Name="EditorButton" Icon="Edit" Label="{l:Loc Key=Dumps_Editor}" />
                    <AppBarButton x:Name="ClearButton" Icon="Delete" Label="{l:Loc Key=Logs_Clear}" Click="ClearClicked" />
                </CommandBar>
            </Grid>
            <ContentControl x:Name="ContentHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <InfoBar x:Name="ErrorBar" Grid.Row="2" Severity="Error" IsClosable="True" CloseButtonClick="DismissError" />
        </Grid>
    </Grid>
</local:FlockWindow>