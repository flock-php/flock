<local:FlockWindow
    x:Class="Flock.Tray.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:Flock.Tray"
    xmlns:local="using:Flock.Tray"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="WindowIcon" Width="16" Height="16" automation:AutomationProperties.Name="Flock" />
                <TextBlock x:Name="WindowCaption" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel x:Name="Page" Padding="32,8,32,24" Spacing="0">
                <StackPanel x:Name="IntroStage" Spacing="0">
                    <StackPanel Margin="0,8,0,24" Spacing="12">
                        <Image Source="Assets/AppIcon.png" Width="48" Height="48" automation:AutomationProperties.Name="Flock" />
                        <TextBlock Text="{l:Loc Key=Setup_Welcome}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{l:Loc Key=Setup_Intro}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,0,24">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{StaticResource GlyphServer}" FontFamily="{StaticResource SymbolsFont}" FontSize="18"
                                          automation:AutomationProperties.Name="{l:Loc Key=Setup_Background}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{l:Loc Key=Setup_Background}" />
                                    <TextBlock Text="{l:Loc Key=Setup_BackgroundDescription}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{StaticResource GlyphTerminal}" FontFamily="{StaticResource SymbolsFont}" FontSize="18"
                                          automation:AutomationProperties.Name="{l:Loc Key=Setup_Terminal}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{l:Loc Key=Setup_TerminalTitle}" />
                                    <TextBlock Text="{l:Loc Key=Setup_TerminalDescription}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{StaticResource GlyphLock}" FontFamily="{StaticResource SymbolsFont}" FontSize="18"
                                          automation:AutomationProperties.Name="{l:Loc Key=Setup_TrustedHttps}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{l:Loc Key=Setup_TrustedHttpsTitle}" />
                                    <TextBlock
                                        Text="{l:Loc Key=Setup_TrustedHttpsDescription}"
                                        Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <CheckBox x:Name="Startup" Content="{l:Loc Key=Setup_OpenAtSignIn}" IsChecked="True" Margin="0,12,0,0" />
                    <!-- Settings → General isn't available before the setup; the language can be changed here. -->
                    <StackPanel x:Name="LanguageHost" Margin="0,16,0,0" />
                    <StackPanel x:Name="IntroButtons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{l:Loc Key=Setup_NotNow}" Click="CloseClicked" />
                        <Button Content="{l:Loc Key=Setup_SetUpFlock}" Click="RunClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="CheckingStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc Key=Setup_CheckingPorts}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,24" />
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,16" />
                </StackPanel>

                <StackPanel x:Name="ConflictsStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc Key=Setup_QuitOthers}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock Text="{l:Loc Key=Setup_QuitOthersDescription}" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                    <ItemsControl x:Name="ConflictsItems" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{StaticResource GlyphWarning}" FontFamily="{StaticResource SymbolsFont}" FontSize="18"
                                                  automation:AutomationProperties.Name="{l:Loc Key=Setup_Warning}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{l:Loc Key=Setup_NotNow}" Click="CloseClicked" /><Button Content="{l:Loc Key=Setup_CheckAgain}" Click="RunClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RunningStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc Key=Setup_SettingUp}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock Text="{l:Loc Key=Setup_AdminPrompt}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,24" />
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,16" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DoneStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="{l:Loc Key=Setup_Ready}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,24" />
                    <StackPanel x:Name="Defaults" Spacing="4" Margin="0,0,0,24" />
                    <TextBlock x:Name="StartupProblem" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                               Margin="0,0,0,12" />
                    <TextBlock Text="{l:Loc Key=Setup_NextSteps}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
                    <StackPanel Spacing="4">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{l:Loc Key=Setup_NewTerminal}" />
                                <TextBlock Text="{l:Loc Key=Setup_NewTerminalDescription}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{l:Loc Key=Setup_LinkProject}" />
                                <TextBlock Text="{l:Loc Key=Setup_LinkProjectDescription}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{l:Loc Key=Setup_PhpAndNode}" />
                                <TextBlock Text="{l:Loc Key=Setup_PhpAndNodeDescription}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{l:Loc Key=Setup_OpenSettings}" Click="OpenSettingsClicked" />
                        <Button Content="{l:Loc Key=Common_Done}" Click="CloseClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="FailedStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock x:Name="FailedTitle" Text="{l:Loc Key=Setup_DidNotFinish}" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock x:Name="FailedMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="FailedLogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="{l:Loc Key=Common_Close}" Click="CloseClicked" /><Button Content="{l:Loc Key=Setup_TryAgain}" Click="RetryClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:FlockWindow>
