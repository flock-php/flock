<Window
    x:Class="Flock.Tray.PanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        x:Name="Scroller"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Root" Spacing="12" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image x:Name="TrayIcon" Width="26" Height="26" />
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <ProgressRing
                    Grid.Column="1"
                    Width="16"
                    Height="16"
                    IsActive="True"
                    Visibility="{Binding RestartVisibility}" />
            </Grid>

            <Grid Visibility="{Binding UpdateVisibility}" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="{StaticResource GlyphDownload}" FontFamily="{StaticResource SymbolsFont}" FontSize="14"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Update" Command="{Binding InstallUpdateCommand}" Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="{Binding CanInstallUpdate}" />
            </Grid>

            <InfoBar
                Title=""
                Message="{Binding ActionError}"
                IsOpen="{Binding HasActionError}"
                IsClosable="True"
                Severity="Error"
                CloseButtonClick="DismissError" />

            <StackPanel Spacing="12" Visibility="{Binding StatusContentVisibility}">
                <StackPanel Spacing="4" Visibility="{Binding WarningsVisibility}">
                    <ItemsControl ItemsSource="{Binding Status.Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="{StaticResource GlyphWarning}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <StackPanel Spacing="5">
                    <TextBlock Text="SERVICES" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDotStyle}" Fill="{Binding StatusBrush}" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <StackPanel Spacing="4">
                    <TextBlock Text="SITES" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Text="No sites yet — run `flock link` or `flock park`, or add a site in Settings."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Visibility="{Binding EmptySitesVisibility}" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Visibility="{Binding SitesVisibility}">
                        <ItemsControl ItemsSource="{Binding Sites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="6,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        IsEnabled="{Binding HasUrl}"
                                        ToolTipService.ToolTip="{Binding SiteTooltip}"
                                        Click="OpenSite">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="{Binding SecurityGlyph}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                          Foreground="{Binding SecurityBrush}" />
                                                <StackPanel Spacing="0">
                                                    <TextBlock Text="{Binding Domain}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Problem}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                               TextTrimming="CharacterEllipsis" Visibility="{Binding ProblemVisibility}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <FontIcon Glyph="{StaticResource GlyphBug}" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{Binding DebuggingVisibility}" />
                                                <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="7,1,7,2"
                                                        Visibility="{Binding FrankenPhpVisibility}">
                                                    <TextBlock Text="{Binding WorkerLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="8" Padding="7,1,7,2"
                                                        Visibility="{Binding SharedVisibility}" ToolTipService.ToolTip="{Binding ShareTooltip}">
                                                    <TextBlock Text="Shared" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding PhpLabel}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <StackPanel Spacing="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource GlyphBug}" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                            <TextBlock Text="Xdebug" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Status.Xdebug}" OnContent="" OffContent="" MinWidth="0" Toggled="XdebugToggled" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="{StaticResource GlyphDownload}" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                            <TextBlock Text="Capture dumps" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{Binding Status.Dumps}" IsEnabled="{Binding CaptureEnabled}" OnContent="" OffContent="" MinWidth="0"
                                      Toggled="DumpsToggled" />
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-16,0" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding OpenMailCommand}" Padding="4,8">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource GlyphMail}" FontFamily="{StaticResource SymbolsFont}" FontSize="18" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="Mail" FontSize="12" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1"
                                        Visibility="{Binding MailCountVisibility}">
                                    <TextBlock Text="{Binding MailCount}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Command="{Binding OpenDumpsCommand}" Padding="4,8">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource GlyphBug}" FontFamily="{StaticResource SymbolsFont}" FontSize="18" />
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <TextBlock Text="Dumps" FontSize="12" />
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="6,1"
                                        Visibility="{Binding DumpCountVisibility}">
                                    <TextBlock Text="{Binding DumpCount}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding OpenLogsCommand}" Padding="4,8">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon Glyph="{StaticResource GlyphDocument}" FontFamily="{StaticResource SymbolsFont}" FontSize="18" />
                            <TextBlock Text="Logs" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8" Visibility="{Binding NotRunningVisibility}">
                <StackPanel Spacing="8" Visibility="{Binding SetupVisibility}">
                    <TextBlock Text="Flock isn't set up for this user yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="Set Up Flock…" Command="{Binding OpenSetupCommand}" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{Binding UpdatingVisibility}">
                    <TextBlock Text="Updating Flock…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{Binding StoppedVisibility}">
                    <TextBlock Text="{Binding NotRunningMessage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Button Content="Start Flock" Command="{Binding RestartCommand}" Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding StartEnabled}" />
                </StackPanel>
            </StackPanel>

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <HyperlinkButton Content="Restart" Command="{Binding RestartCommand}" Padding="4,2" Visibility="{Binding FooterVisibility}"
                                     IsEnabled="{Binding RestartEnabled}" />
                    <HyperlinkButton Content="Settings…" Command="{Binding OpenSettingsCommand}" Padding="4,2" Visibility="{Binding FooterVisibility}" />
                </StackPanel>
                <HyperlinkButton Grid.Column="1" Content="Quit Flock" Command="{Binding QuitCommand}" Padding="4,2" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>