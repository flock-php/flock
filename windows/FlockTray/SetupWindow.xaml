<local:FlockWindow
    x:Class="Flock.Tray.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flock.Tray">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="WindowIcon" Width="16" Height="16" />
                <TextBlock x:Name="WindowCaption" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="Scroller" Grid.Row="1">
            <StackPanel x:Name="Page" Padding="32,8,32,24" Spacing="0">
                <StackPanel x:Name="IntroStage" Spacing="0">
                    <StackPanel Margin="0,8,0,24" Spacing="12">
                        <Image Source="Assets/AppIcon.png" Width="48" Height="48" />
                        <TextBlock Text="Welcome to Flock" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Flock runs your Laravel sites, PHP, mail and databases on this PC. Setting it up takes a moment:" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4" Margin="0,0,0,24">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Runs in the background" />
                                <TextBlock Text="The Flock daemon serves your sites and services, and starts whenever you sign in."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="php, composer and node in your terminal" />
                                <TextBlock Text="Flock's versions come first on your PATH. Open a new terminal after setup."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="*.test sites with trusted HTTPS" />
                                <TextBlock
                                    Text="Windows asks once for administrator permission: for the small service that adds your sites to the hosts file, and to trust Flock's certificate."
                                    Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <CheckBox x:Name="Startup" Content="Open Flock when I sign in" IsChecked="True" Margin="0,12,0,0" />
                    <StackPanel x:Name="IntroButtons" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Not now" Click="CloseClicked" />
                        <Button Content="Set up Flock" Click="RunClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="CheckingStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="Checking Flock's ports…" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,24" />
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,16" />
                </StackPanel>

                <StackPanel x:Name="ConflictsStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="Quit other local environments first" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock Text="Flock needs these ports for itself, but other programs use them. Running both would leave neither working." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                    <ItemsControl x:Name="ConflictsItems" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,4">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Not now" Click="CloseClicked" /><Button Content="Check again" Click="RunClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="RunningStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="Setting up Flock…" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock Text="Windows asks for administrator permission in a moment." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,24" />
                    <ProgressBar IsIndeterminate="True" Margin="0,0,0,16" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="DoneStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock Text="Flock is ready" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,24" />
                    <StackPanel x:Name="Defaults" Spacing="4" Margin="0,0,0,24" />
                    <TextBlock x:Name="StartupProblem" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                               Margin="0,0,0,12" />
                    <TextBlock Text="Next steps" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
                    <StackPanel Spacing="4">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Open a new terminal" />
                                <TextBlock Text="Terminals that were already open still have the old PATH." Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="Link a project" />
                                <TextBlock Text="In a Laravel project, run `flock link`: the site is then at http://&lt;folder&gt;.test. `flock secure` adds HTTPS."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="16,12">
                            <StackPanel Spacing="1">
                                <TextBlock Text="PHP and Node.js" />
                                <TextBlock Text="Flock installs the newest PHP and Node.js LTS as the defaults. Settings → PHP and Node install other versions."
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Open Settings" Click="OpenSettingsClicked" />
                        <Button Content="Done" Click="CloseClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="FailedStage" Spacing="0" Visibility="Collapsed">
                    <TextBlock x:Name="FailedTitle" Text="Setup didn't finish" Style="{StaticResource TitleTextBlockStyle}" Margin="0,8,0,4" />
                    <TextBlock x:Name="FailedMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="FailedLogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Close" Click="CloseClicked" /><Button Content="Try Again" Click="RetryClicked" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:FlockWindow>