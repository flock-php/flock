<local:FlockWindow
    x:Class="Flock.Tray.LogsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flock.Tray">
    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><Image x:Name="WindowIcon" Width="16" Height="16" /><TextBlock x:Name="WindowCaption" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
        <Grid x:Name="WindowBody" Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Padding="16,0" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"><AutoSuggestBox x:Name="Search" PlaceholderText="Search messages and context" QueryIcon="Find" Width="260" TextChanged="SearchChanged" /><ComboBox x:Name="Levels" MinWidth="170" SelectedIndex="0" SelectionChanged="LevelChanged" ToolTipService.ToolTip="Levels of a site's Laravel log to show" /></StackPanel><CommandBar Grid.Column="1" DefaultLabelPosition="Right" HorizontalAlignment="Right"><AppBarToggleButton x:Name="AutoRefresh" Icon="Sync" Label="Auto-refresh" Click="AutoRefreshClicked" /><AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding RefreshCommand}" /><AppBarButton x:Name="ClearButton" Icon="Delete" Label="Clear" Click="ClearClicked" Visibility="Collapsed" /></CommandBar></Grid>
            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"><StackPanel Padding="8,0,8,8" Spacing="4"><TextBlock Text="SITES" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="8,10,0,2" /><ListView x:Name="SiteList" ItemsSource="{Binding SiteSources}" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Button Content="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,7" Click="SourceClicked" /></DataTemplate></ListView.ItemTemplate></ListView><TextBlock Text="SERVICES" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" Margin="8,18,0,2" /><ListView x:Name="ServiceList" ItemsSource="{Binding ServiceSources}" SelectionMode="Single"><ListView.ItemTemplate><DataTemplate><Button Content="{Binding Name}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,7" Click="SourceClicked" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></ScrollViewer>
                <Border Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0"><Grid x:Name="DetailRoot"><ContentControl x:Name="DetailStateHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /><ListView x:Name="EntryList" Visibility="Collapsed" ItemsSource="{Binding FilteredEntries}" SelectionMode="None" Padding="8,4"><ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="0,8"><StackPanel Orientation="Horizontal" Spacing="8"><Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,1,6,2"><TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" /></Border><TextBlock Text="{Binding Time}" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Text="{Binding Env}" Style="{StaticResource CaptionTextBlockStyle}" /></StackPanel><TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" MaxLines="3" /><Expander Header="Details"><ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto"><TextBlock Text="{Binding Details}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" /></ScrollViewer></Expander></StackPanel></DataTemplate></ListView.ItemTemplate></ListView></Grid></Border>
            </Grid>
            <InfoBar x:Name="ErrorBar" Grid.Row="2" Grid.ColumnSpan="2" Severity="Error" IsClosable="True" CloseButtonClick="DismissError" />
        </Grid>
    </Grid>
</local:FlockWindow>
