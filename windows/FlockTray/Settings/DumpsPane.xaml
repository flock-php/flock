<UserControl
    x:Class="Flock.Tray.DumpsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="0">
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <Border Style="{StaticResource CardStyle}"><Grid Style="{StaticResource SettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="1"><TextBlock Text="Capture dumps" /><TextBlock Text="Turn it off to see dumps in the page again." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel><ToggleSwitch Grid.Column="1" MinWidth="0" IsOn="{Binding Capturing}" Toggled="CaptureToggled" OnContent="" OffContent="" /></Grid></Border>
            <Border Style="{StaticResource CardStyle}"><Grid Style="{StaticResource SettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Captured" /><Button Grid.Column="1" Content="Open Dumps" Click="OpenDumps" /></Grid></Border>
        </StackPanel>
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <TextBlock Text="Sources" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="1,0,0,6" />
            <Border Style="{StaticResource CardStyle}"><Grid Style="{StaticResource SettingRowStyle}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Open files in" /><ComboBox x:Name="Editor" Grid.Column="1" MinWidth="160" SelectionChanged="EditorChanged" /></Grid></Border>
        </StackPanel>
    </StackPanel>
</UserControl>
