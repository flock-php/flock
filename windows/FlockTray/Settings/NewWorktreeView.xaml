<UserControl
    x:Class="Flock.Tray.NewWorktreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <TextBox x:Name="BranchBox" Header="Branch" PlaceholderText="a name like brave-otter" TextChanged="BranchChanged" />
        <!-- Disabled until the branches are loaded. -->
        <ComboBox x:Name="FromBox" Header="Start from" MinWidth="260" IsEnabled="False" />
        <StackPanel Spacing="4">
            <ComboBox x:Name="DatabaseBox" Header="Database" MinWidth="200" />
            <TextBlock Text="A database of its own gets the migrations run. Project default is what flock.yml says, else the site's."
                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="ExplanationText" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
