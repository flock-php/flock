<UserControl
    x:Class="Flock.Tray.PhpPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flock.Tray"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <UserControl.Resources>
        <local:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <local:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
        <local:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="0">
        <StackPanel Spacing="4" Margin="0,0,0,24">
            <Grid Margin="1,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="PHP-CGI" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding CheckedText}" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button Content="Check now" Click="CheckPhp" Visibility="{Binding IsChecking, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                    <ProgressRing Width="14" Height="14" IsActive="True" Visibility="{Binding IsChecking, Converter={StaticResource BooleanVisibilityConverter}}" />
                </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Versions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding VersionText}" />
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding IsDefault, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="Default" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding IsPrerelease, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="Pre-release" FontSize="11" />
                                        </Border>
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding HasXdebug, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="Xdebug" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding WithdrawnText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsWithdrawn, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <TextBlock Text="{Binding JobErrorText}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding JobErrorText, Converter={StaticResource StringVisibilityConverter}}" />
                                    <local:OperationProgress Text="{Binding JobProgressText}" Value="{Binding JobProgress}"
                                                             IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                                                             Visibility="{Binding HasRunningJob, Converter={StaticResource BooleanVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Install" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryInstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Update" Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryUpdate, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Uninstall…" Click="UninstallPhp"
                                            Visibility="{Binding ShowPrimaryUninstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                                            Visibility="{Binding ShowPrimaryCancel, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Retry" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryRetry, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Click="OpenPhpActions" Padding="8,6" ToolTipService.ToolTip="More actions"
                                            automation:AutomationProperties.Name="More actions"
                                            Visibility="{Binding HasMoreActions, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding CheckErrorText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Visibility="{Binding CheckErrorText, Converter={StaticResource StringVisibilityConverter}}" />
        </StackPanel>
        <StackPanel Spacing="4" Visibility="{Binding FrankenPhpVisibility}">
            <Grid Margin="1,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="FrankenPHP" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <Grid Grid.Column="1">
                    <Button Content="Check now" Click="CheckFranken"
                            Visibility="{Binding IsFrankenChecking, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                    <ProgressRing Width="14" Height="14" IsActive="True" Visibility="{Binding IsFrankenChecking, Converter={StaticResource BooleanVisibilityConverter}}" />
                </Grid>
            </Grid>
            <ItemsControl ItemsSource="{Binding Builds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Php}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding Installed}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <local:OperationProgress Text="{Binding JobProgressText}" Value="{Binding JobProgress}"
                                                             IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                                                             Visibility="{Binding HasRunningJob, Converter={StaticResource BooleanVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Install" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryInstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Update" Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryUpdate, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Uninstall" Command="{Binding UninstallCommand}"
                                            Visibility="{Binding ShowPrimaryUninstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Cancel" Command="{Binding CancelCommand}"
                                            Visibility="{Binding ShowPrimaryCancel, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Content="Retry" Command="{Binding InstallCommand}"
                                            Visibility="{Binding ShowPrimaryRetry, Converter={StaticResource BooleanVisibilityConverter}}" />
                                    <Button Click="OpenFrankenPhpActions" Padding="8,6" ToolTipService.ToolTip="More actions"
                                            automation:AutomationProperties.Name="More actions"
                                            Visibility="{Binding HasMoreActions, Converter={StaticResource BooleanVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding FrankenCurrent.CheckError}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                       Visibility="{Binding FrankenCurrent.CheckError, Converter={StaticResource StringVisibilityConverter}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
