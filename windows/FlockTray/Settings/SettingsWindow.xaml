<local:FlockWindow
    x:Class="Flock.Tray.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flock.Tray">
    <Grid x:Name="WindowRoot" Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="WindowTitleBar" Grid.Row="0" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="WindowIcon" Width="16" Height="16" />
                <TextBlock x:Name="WindowCaption" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsSettingsVisible="False"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="220"
            SelectionChanged="NavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Sites" Tag="Sites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="PHP" Tag="Php">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Node" Tag="Node">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE756;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Services" Tag="Services">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE968;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mail" Tag="Mail">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE715;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Dumps" Tag="Dumps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Debugger" Tag="Debugger">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEBE8;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI" Tag="Ai">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE99A;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{StaticResource SymbolsFont}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid x:Name="Page">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="PaneHeading" Grid.Row="0" Margin="36,0,36,20" Spacing="2">
                        <TextBlock x:Name="PaneTitle" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock x:Name="Subtitle" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="PaneHost" Padding="36,0,36,24" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <InfoBar
                        x:Name="ErrorBar"
                        Grid.Row="2"
                        Margin="36,0,36,16"
                        Severity="Error"
                        IsClosable="True"
                        IsOpen="False"
                        CloseButtonClick="DismissError" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</local:FlockWindow>