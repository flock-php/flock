<UserControl
    x:Class="Flock.Tray.NodePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flock.Tray"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">
    <UserControl.Resources>
        <local:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" />
        <local:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
        <local:StringVisibilityConverter x:Key="StringVisibilityConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="4">
        <Grid Margin="1,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Versions" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding CheckedText}" Style="{StaticResource CaptionTextBlockStyle}" />
                <Button Content="Check now" Click="CheckNode" Visibility="{Binding IsChecking, Converter={StaticResource InverseBooleanVisibilityConverter}}" />
                <ProgressRing Width="14" Height="14" IsActive="True" Visibility="{Binding IsChecking, Converter={StaticResource BooleanVisibilityConverter}}" />
            </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Versions}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding IsDefault, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="Default" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                     <StackPanel Orientation="Horizontal" Spacing="6">
                                         <TextBlock Text="{Binding NpmText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                    Visibility="{Binding NpmText, Converter={StaticResource StringVisibilityConverter}}" />
                                        <TextBlock Text="{Binding NpmLatestText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                    Visibility="{Binding NpmLatestText, Converter={StaticResource StringVisibilityConverter}}" />
                                     </StackPanel>
                                     <local:OperationProgress Text="{Binding JobProgressText}" IsIndeterminate="{Binding IsJobProgressIndeterminate}"
                                                              Visibility="{Binding HasRunningJob, Converter={StaticResource BooleanVisibilityConverter}}" />
                             </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Install" Command="{Binding InstallCommand}"
                                        Visibility="{Binding ShowPrimaryInstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <Button Content="Update" Style="{StaticResource AccentButtonStyle}" Command="{Binding InstallCommand}"
                                        Visibility="{Binding ShowPrimaryUpdate, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <Button Content="Uninstall…" Click="UninstallNode"
                                        Visibility="{Binding ShowPrimaryUninstall, Converter={StaticResource BooleanVisibilityConverter}}" />
                                <Button Click="OpenNodeActions" Padding="8,6" ToolTipService.ToolTip="More actions" automation:AutomationProperties.Name="More actions"
                                        Visibility="{Binding HasMoreActions, Converter={StaticResource BooleanVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE712;" FontFamily="{StaticResource SymbolsFont}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No Node.js versions to show yet." Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BooleanVisibilityConverter}}" />
        <TextBlock Text="{Binding CheckErrorText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap"
                   Visibility="{Binding CheckErrorText, Converter={StaticResource StringVisibilityConverter}}" />
        <TextBlock
            Text="Official Node.js builds, the newest release of each major. A project that pins a version in .nvmrc gets that major offered when you run node, npm or npx there. Global packages belong to a Node line and survive its updates; those of the default version are on your PATH."
            Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="2,6,0,0" />
    </StackPanel>
</UserControl>
