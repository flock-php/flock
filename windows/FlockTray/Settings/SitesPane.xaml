<UserControl
    x:Class="Flock.Tray.SitesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Flock.Tray">
    <UserControl.Resources>
        <local:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter" /><local:StringVisibilityConverter x:Key="StringVisibilityConverter" />
        <local:InverseBooleanVisibilityConverter x:Key="InverseBooleanVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid ColumnSpacing="16" Visibility="{Binding HasSites, Converter={StaticResource BooleanVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" /><ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Button Content="Add Site…" Click="AddSiteClicked" HorizontalAlignment="Left" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,14,8">
                    <ListView x:Name="SiteList" ItemsSource="{Binding Sites}" SelectionChanged="SiteSelectionChanged" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="8" Margin="{Binding ListMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding ListTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Domain}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Problem}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Problem, Converter={StaticResource StringVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <ProgressRing Width="12" Height="12" ToolTipService.ToolTip="{Binding SetupStep}"
                                                      Visibility="{Binding IsSettingUp, Converter={StaticResource BooleanVisibilityConverter}}" />
                                        <Border Style="{StaticResource BadgeStyle}" ToolTipService.ToolTip="{Binding DatabaseTooltip}"
                                                Visibility="{Binding HasOwnDatabase, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="{Binding DatabaseLabel}" FontSize="11" />
                                        </Border>
                                        <FontIcon Glyph="&#xE72E;" FontFamily="{StaticResource SymbolsFont}" FontSize="12"
                                                  Visibility="{Binding Secured, Converter={StaticResource BooleanVisibilityConverter}}" />
                                        <Border Style="{StaticResource BadgeStyle}" Visibility="{Binding IsShared, Converter={StaticResource BooleanVisibilityConverter}}">
                                            <TextBlock Text="Shared" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>
            <ScrollViewer Grid.Column="1" x:Name="DetailScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="DetailHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </ScrollViewer>
        </Grid>
        <!-- No sites: only the empty state, centred in the whole pane. -->
        <StackPanel Style="{StaticResource EmptyStateStyle}" Spacing="8"
                    Visibility="{Binding HasSites, Converter={StaticResource InverseBooleanVisibilityConverter}}">
            <FontIcon Glyph="&#xE774;" FontFamily="{StaticResource SymbolsFont}" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                      HorizontalAlignment="Center" />
            <TextBlock Text="No sites" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Add a single site here, or add a project folder in General." Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
            <Button Content="Add Site…" Click="AddSiteClicked" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
