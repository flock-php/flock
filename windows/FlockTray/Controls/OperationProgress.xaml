<UserControl
    x:Class="Flock.Tray.OperationProgress"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <ProgressRing Width="14" Height="14" IsActive="True" />
            <TextBlock Text="{Binding Text, ElementName=Root}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding Value, ElementName=Root}" IsIndeterminate="{Binding IsIndeterminate, ElementName=Root}" />
    </StackPanel>
</UserControl>
