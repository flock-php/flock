<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="SymbolsFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <x:String x:Key="GlyphBug">&#xEBE8;</x:String>
    <x:String x:Key="GlyphCheck">&#xE73E;</x:String>
    <x:String x:Key="GlyphDocument">&#xE8A5;</x:String>
    <x:String x:Key="GlyphDownload">&#xE896;</x:String>
    <x:String x:Key="GlyphGlobe">&#xE774;</x:String>
    <x:String x:Key="GlyphLock">&#xE72E;</x:String>
    <x:String x:Key="GlyphMail">&#xE715;</x:String>
    <x:String x:Key="GlyphSettings">&#xE713;</x:String>
    <x:String x:Key="GlyphServer">&#xE968;</x:String>
    <x:String x:Key="GlyphTerminal">&#xE756;</x:String>
    <x:String x:Key="GlyphWarning">&#xE7BA;</x:String>
    <Thickness x:Key="CardPadding">16,12,16,12</Thickness>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">8</CornerRadius>
    <Thickness x:Key="PanelPadding">16</Thickness>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
    </Style>
    <Style x:Key="SettingRowStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource BadgeCornerRadius}" />
        <Setter Property="Padding" Value="7,1,7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="StatusDotStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="420" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="CodeBlockStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,8,40,8" />
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style x:Key="ErrorBarStyle" TargetType="InfoBar">
        <Setter Property="Severity" Value="Error" />
        <Setter Property="Margin" Value="12,0,12,12" />
    </Style>
</ResourceDictionary>
