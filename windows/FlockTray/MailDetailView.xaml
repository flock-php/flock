<Grid
    x:Class="Flock.Tray.MailDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel x:Name="Header" Spacing="8" Padding="20,16,20,12">
        <TextBlock x:Name="Subject" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        <Grid ColumnSpacing="12" RowSpacing="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="From" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="From" Grid.Row="0" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Text="To" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="To" Grid.Row="1" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <TextBlock x:Name="CcLabel" Grid.Row="2" Text="Cc" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            <TextBlock x:Name="Cc" Grid.Row="2" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Grid.Row="3" Text="Date" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="Date" Grid.Row="3" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="Inbox" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="Inbox" Grid.Row="4" Grid.Column="1" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </Grid>
        <ScrollViewer x:Name="AttachmentsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <StackPanel x:Name="Attachments" Orientation="Horizontal" Spacing="8" />
        </ScrollViewer>
        <SelectorBar x:Name="Modes" SelectionChanged="ModeChanged">
            <SelectorBarItem Text="HTML" Tag="HTML" /><SelectorBarItem Text="Text" Tag="Text" /><SelectorBarItem Text="Raw" Tag="Raw" />
            <SelectorBarItem Text="Headers" Tag="Headers" />
        </SelectorBar>
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <ContentControl x:Name="ContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Border>
</Grid>