<Project Sdk="Microsoft.NET.Sdk">
    <!-- Models and the API client, free of UI so they can be unit tested on any OS (dotnet test). -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Flock.Kit</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <UseWPF>false</UseWPF>
        <UseWindowsForms>false</UseWindowsForms>
    </PropertyGroup>
    <ItemGroup>
        <!-- Translations: Strings.cs.resx and Strings.es.resx build into satellite assemblies (cs\, es\). -->
        <EmbeddedResource Update="Strings.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Strings.Designer.cs"/>
        <Compile Update="Strings.Designer.cs" DesignTime="True" AutoGen="True" DependentUpon="Strings.resx"/>
    </ItemGroup>
</Project>
