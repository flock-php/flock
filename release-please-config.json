{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "pull-request-header": "Pending release",
  "draft-pull-request": true,
  "pull-request-footer": "Mark this PR ready for review to build it for macOS and Windows. Once the builds pass, merging it tags this version, creates a GitHub release and attaches those builds to it.",
  "packages": {
    ".": {
      "release-type": "go",
      "initial-version": "1.0.0",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "refactor", "section": "Refactor" },
        { "type": "style", "section": "Style" },
        { "type": "revert", "section": "Reverts" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "chore", "section": "Chore", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true }
      ]
    }
  }
}
