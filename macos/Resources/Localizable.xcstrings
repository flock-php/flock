    "dumps.dd_always_shows_in_the" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() se vždy zobrazí i na stránce, protože ukončí požadavek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() always shows in the page too, as it ends the request."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() siempre se muestra también en la página, porque termina la solicitud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() isteği sonlandırdığı için her zaman sayfada da görünür."
          }
        }
      }
    },
    "dumps.dd_always_shows_in_the_page %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() se vždy zobrazí i na stránce, protože ukončí požadavek. PHP %@ zachytávají jen dumpy: jejich sestavení zatím nemají rozšíření agenta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() always shows in the page too, as it ends the request. PHP %@ only capture dumps: their builds have no agent extension yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() siempre se muestra también en la página, porque termina la solicitud. PHP %@ solo capturan dumps: sus compilaciones aún no tienen la extensión del agente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() isteği sonlandırdığı için her zaman sayfada da görünür. PHP %@ yalnızca dump'ları yakalar: bu sürümlerin derlemelerinde henüz ajan eklentisi yok."
          }
        }
      }
    },
    "dumps.dd_always_shows_in_the_page_too %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() se vždy zobrazí i na stránce, protože ukončí požadavek. PHP %@ zachytává jen dumpy: jeho sestavení zatím nemá rozšíření agenta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() always shows in the page too, as it ends the request. PHP %@ only captures dumps: its build has no agent extension yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() siempre se muestra también en la página, porque termina la solicitud. PHP %@ solo captura dumps: su compilación aún no tiene la extensión del agente."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "dd() isteği sonlandırdığı için her zaman sayfada da görünür. PHP %@ yalnızca dump'ları yakalar: bu sürümün derlemesinde henüz ajan eklentisi yok."
          }
        }
      }
    },
    "dumps.dumps %@" : {
      "localizations" : {
