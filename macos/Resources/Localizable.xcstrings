    "Sites don't open while the web server is down. Its log may tell why; `flock restart` starts it again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokud webový server neběží, weby se neotevřou. Proč, může prozradit jeho log; `flock restart` ho znovu spustí."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los sitios no se abren mientras el servidor web está caído. Su registro puede indicar por qué; `flock restart` lo vuelve a iniciar."
          }
        }
      }
    },
    "Sites that run on FrankenPHP with this version are served by PHP-FPM until it has downloaded again by itself." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
