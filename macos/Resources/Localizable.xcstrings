    "app.flock_is_not_installed_for %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock pro tohoto uživatele není nainstalovaný (chybí %@) — jednou spusťte `flock install`."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock is not installed for this user (%@ is missing) — run `flock install` once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock no está instalado para este usuario (falta %@): ejecuta `flock install` una vez."
