    "ai.added_once" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí přidat jednou a Flock funguje v každém projektu. Po přidání Flocku klienta restartujte nebo znovu načtěte jeho MCP servery."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added once, Flock works in every project. Restart the client, or reload its MCP servers, after adding Flock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez añadido, Flock funciona en todos los proyectos. Después de añadir Flock, reinicia el cliente o vuelve a cargar sus servidores MCP."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez eklenince Flock her projede çalışır. Flock'u ekledikten sonra istemciyi yeniden başlatın veya MCP sunucularını yeniden yükleyin."
          }
        }
      }
