    "debugger.subtitle" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krokujte požadavky a příkazy pomocí Xdebugu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step through requests and commands with Xdebug."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depura paso a paso solicitudes y comandos con Xdebug."
          }
        }
      }
    },
    "debugger.xdebug_loads_only_for_requests" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xdebug se načítá jen pro požadavky, které o něj žádají, takže vše ostatní zůstává rychlé. Dokud má projekt v PhpStormu breakpointy, ladí se každý požadavek na jeho web."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xdebug loads only for requests that ask for it, so everything else stays fast. While a project has breakpoints in PhpStorm, every request to its site is debugged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xdebug solo se carga en las solicitudes que lo piden, así que todo lo demás sigue siendo rápido. Mientras un proyecto tenga puntos de interrupción en PhpStorm, se depura cada solicitud a su sitio."
          }
        }
      }
    },
