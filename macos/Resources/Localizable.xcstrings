    "about.flock_stops_and_is_removed" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock se zastaví a odebere se z PATH spolu se svými verzemi PHP a Node.js, certifikáty, logy a mezipamětí. macOS si vyžádá heslo, aby mohl odebrat nastavení DNS pro *.test a důvěryhodný certifikát Flocku. Pak se tato aplikace přesune do Koše."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock stops and is removed from your PATH, together with its PHP and Node.js versions, certificates, logs and caches. macOS asks for your password to remove the *.test DNS setup and Flock's trusted certificate. Then this app moves itself to the Trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock se detiene y se quita de tu PATH, junto con sus versiones de PHP y Node.js, certificados, registros y cachés. macOS te pide la contraseña para quitar la configuración DNS de *.test y el certificado de confianza de Flock. Después, esta app se mueve a la Papelera."
          }
        }
      }
    },
    "about.flock_was_uninstalled" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock byl odinstalován"
