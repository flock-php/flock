    "general.doesnt_resolve_macos_has_no %@ %@ %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*.%1$@ se nepřekládá: %2$@. macOS nemá záložní řešení přes soubor hosts, takže se weby neotevřou, dokud se to neopraví; `flock install` znovu nastaví /etc/resolver/%3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*.%1$@ doesn't resolve: %2$@. macOS has no hosts-file fallback, so sites don't open until it does; `flock install` sets /etc/resolver/%3$@ up again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*.%1$@ no se resuelve: %2$@. macOS no recurre al archivo hosts, así que los sitios no se abren hasta que se resuelva; `flock install` vuelve a configurar /etc/resolver/%3$@."
          }
        }
      }
    },
