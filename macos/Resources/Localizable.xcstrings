    "sites.proxy_footnote_commands %@" : {
      "comment" : "{domain}: the domain",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý požadavek se předá cíli i s hlavičkou Host, včetně přechodu na WebSocket (hot reload). Dokud neodpovídá, %@ zobrazuje stránku s touto informací."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every request passes to the upstream with its Host header, WebSocket upgrades (hot reload) included. Until it answers, %@ shows a page saying so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada solicitud pasa al destino con su encabezado Host, incluidas las conexiones WebSocket (recarga en caliente). Hasta que responda, %@ muestra una página que lo indica."
          }
        }
      }
    },
    "sites.proxy_footnote_no_commands %@" : {
      "comment" : "{domain}: the domain",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každý požadavek se předá cíli i s hlavičkou Host, včetně přechodu na WebSocket (hot reload). Flock server nespouští, takže ho spusťte jako obvykle, nebo mu níže zadejte příkazy. Dokud neodpovídá, %@ zobrazuje stránku s touto informací."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every request passes to the upstream with its Host header, WebSocket upgrades (hot reload) included. Flock doesn't start the server, so start it as usual, or give it commands below. Until it answers, %@ shows a page saying so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada solicitud pasa al destino con su encabezado Host, incluidas las conexiones WebSocket (recarga en caliente). Flock no inicia el servidor, así que inícialo como siempre o dale comandos abajo. Hasta que responda, %@ muestra una página que lo indica."
          }
        }
      }
    },
