    "worktrees.new.explain_existing %@ %@ %@" : {
      "comment" : "{branch}: the branch, {site}: the site, {address}: the address",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větev %1$@ už existuje, takže ji worktree použije. Flock ho vytvoří vedle webu %2$@, připraví ho a bude ho obsluhovat na %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ exists, so the worktree checks it out. Flock creates it next to %2$@, sets it up and serves it at %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya existe, así que el worktree la usa. Flock lo crea junto a %2$@, lo prepara y lo sirve en %3$@."
          }
        }
      }
    },
    "worktrees.new.explain_new %@ %@ %@" : {
