{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@" : {
      "shouldTranslate" : false
    },
    "%@ %@ is set for this site on this machine (isolated)." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ je pro tento web nastaven jen na tomto počítači (izolovaně)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ está configurado para este sitio solo en este equipo (aislado)."
          }
        }
      }
    },
    "%@ %@ keeps running until you switch." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ běží, dokud nepřepnete."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ sigue en ejecución hasta que cambies."
          }
        }
      }
    },
    "%@ %@ starts with empty data." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ začne s prázdnými daty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ empieza sin datos."
          }
        }
      }
    },
    "%@ %@ stops and %@ %@ becomes the active version." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ se zastaví a aktivní verzí se stane %3$@ %4$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ se detiene y %3$@ %4$@ pasa a ser la versión activa."
          }
        }
      }
    },
    "%@ %@ stops; its data stays but isn't used until you switch back." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ se zastaví; jeho data zůstanou, ale nepoužijí se, dokud nepřepnete zpět."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ se detiene; sus datos se conservan, pero no se usan hasta que vuelvas a cambiar."
          }
        }
      }
    },
    "%@ %@ stops; your sites can't use %@ until you install a version again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ se zastaví; vaše weby nebudou moci %3$@ používat, dokud znovu nenainstalujete některou verzi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ se detiene; tus sitios no podrán usar %3$@ hasta que vuelvas a instalar una versión."
          }
        }
      }
    },
    "%@ %@ uses its own data." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
