          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sends every name under .%1$@ here (/etc/resolver/%2$@, set up by `flock install`), so any subdomain of a site works (tenant1.app.%3$@, a.b.app.%4$@) without adding it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS envía aquí cada nombre bajo .%1$@ (/etc/resolver/%2$@, lo configura `flock install`), así que cualquier subdominio de un sitio funciona (tenant1.app.%3$@, a.b.app.%4$@) sin añadirlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS отправляет каждое имя под .%1$@ сюда (/etc/resolver/%2$@, настроенный через `flock install`), поэтому любой поддомен сайта работает (tenant1.app.%3$@, a.b.app.%4$@) без добавления."
