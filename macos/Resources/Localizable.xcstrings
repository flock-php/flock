    "sites.version_picked_here_applies_on %@" : {
      "comment" : "{0}: the pin icon",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze zvolená zde platí jen na tomto počítači. Chcete-li ji nastavit všem, kdo na projektu pracují, připněte ji (%@): Node.js se zapíše do .nvmrc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A version picked here applies on this machine only. To set it for everyone working on the project, pin it (%@): Node.js goes into .nvmrc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión que elijas aquí solo se aplica en este equipo. Para fijarla para todo el que trabaje en el proyecto, fíjala (%@): Node.js va a .nvmrc."
          }
        }
      }
    },
    "sites.version_picked_here_applies_on_this %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verze zvolená zde platí jen na tomto počítači. Chcete-li ji nastavit všem, kdo na projektu pracují, připněte ji (%@): PHP se zapíše do .flockrc, Node.js do .nvmrc."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A version picked here applies on this machine only. To set it for everyone working on the project, pin it (%@): PHP goes into .flockrc, Node.js into .nvmrc."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión que elijas aquí solo se aplica en este equipo. Para fijarla para todo el que trabaje en el proyecto, fíjala (%@): PHP va a .flockrc y Node.js a .nvmrc."
          }
        }
      }
    },
