    "about.stops_flock_and_removes_it" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastaví Flock a odebere ho z tohoto Macu. Vaše weby, databáze a nastavení zůstanou zachované."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops Flock and removes it from this Mac. Your sites, databases and settings are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detiene Flock y lo quita de este Mac. Tus sitios, bases de datos y ajustes se conservan."
          }
        }
      }
    },
    "about.support_description" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock je zdarma a open source, navždy. Sponzorství pomáhá udržet jeho vývoj."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock is free and open source, forever. Sponsoring helps keep it maintained."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock es gratuito y de código abierto, para siempre. Patrocinarlo ayuda a mantenerlo."
          }
        }
      }
    },
