    "about.password_prompt_was_cancelled_so" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Výzva k zadání hesla byla zrušena, takže nastavení DNS i certifikát zůstaly na místě."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The password prompt was cancelled, so the DNS setup and the certificate are still in place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se canceló la solicitud de contraseña, así que la configuración DNS y el certificado siguen en su sitio."
          }
        }
      }
    },
    "about.quitting_moves_flock_app_to" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončením se Flock.app přesune do Koše. Otevřete nový terminál: Flock už v jeho PATH není."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitting moves Flock.app to the Trash. Open a new terminal: Flock is no longer on its PATH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir, Flock.app se mueve a la Papelera. Abre una terminal nueva: Flock ya no está en su PATH."
          }
        }
      }
    },
