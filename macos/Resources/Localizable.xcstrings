            "value" : "Runs composer require ext-%1$@:* in %2$@, which changes composer.json and composer.lock. Commit them with the project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta composer require ext-%1$@:* en %2$@, lo que cambia composer.json y composer.lock. Haz commit de ambos con el proyecto."
          }
