                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cualquier subdominio de hasta %1$lld nivel por debajo del sitio ya funciona. Añade un nombre completo como %2$@ para un alias, o un subdominio (tenant1, a.b) para que aparezca aquí y también se resuelva en equipos Windows sin DNS comodín."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Cualquier subdominio de hasta %1$lld niveles por debajo del sitio ya funciona. Añade un nombre completo como %2$@ para un alias, o un subdominio (tenant1, a.b) para que aparezca aquí y también se resuelva en equipos Windows sin DNS comodín."
                }
