    "sites.server.flock_starts_the_dev_server" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock spustí vývojový server při první návštěvě webu a zastaví ho po 30 minutách bez požadavků. Otevřená karta s hot reloadem ho udržuje v běhu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock starts the dev server when the site is first visited, and stops it after 30 minutes without requests. An open tab with hot reload keeps it running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock inicia el servidor de desarrollo cuando se visita el sitio por primera vez y lo detiene tras 30 minutos sin solicitudes. Una pestaña abierta con recarga en caliente lo mantiene en ejecución."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock, siteye ilk girildiğinde geliştirme sunucusunu başlatır ve 30 dakika istek gelmezse durdurur. Hot reload'lu açık bir sekme sunucuyu çalışır tutar."
          }
