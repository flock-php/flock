    "about.this_copy_of_the_app" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato kopie aplikace není ve složce Aplikace, takže zůstane, kde je; smažte ji sami. Otevřete nový terminál: Flock už v jeho PATH není."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This copy of the app isn't in an Applications folder, so it stays where it is; delete it yourself. Open a new terminal: Flock is no longer on its PATH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de la app no está en una carpeta Aplicaciones, así que se queda donde está; elimínala tú. Abre una terminal nueva: Flock ya no está en su PATH."
          }
        }
      }
    },
