    "node.official_node_js_builds_the" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oficiální sestavení Node.js, nejnovější vydání každé hlavní verze. Projektu, který má verzi připnutou v .nvmrc, se tato hlavní verze nabídne, když v něm spustíte node, npm nebo npx. Globální balíčky (npm install -g) patří k řadě Node a přežijí její aktualizace; ty z výchozí verze jsou v PATH."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Official Node.js builds, the newest release of each major. A project that pins a version in .nvmrc gets that major offered when you run node, npm or npx there. Global packages (npm install -g) belong to a Node line and survive its updates; those of the default version are on your PATH."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compilaciones oficiales de Node.js, la versión más reciente de cada versión principal. A un proyecto que fija una versión en .nvmrc se le ofrece esa versión principal cuando ejecutas node, npm o npx en él. Los paquetes globales (npm install -g) pertenecen a una línea de Node y sobreviven a sus actualizaciones; los de la versión predeterminada están en tu PATH."
          }
        }
      }
    },
    "node.subtitle" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node, npm a npx se řídí souborem .nvmrc / .node-version projektu, pak verzí webu a nakonec výchozí verzí."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node, npm and npx follow the project's .nvmrc / .node-version, then the site's version, then the default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "node, npm y npx siguen el .nvmrc / .node-version del proyecto, después la versión del sitio y, por último, la predeterminada."
          }
        }
      }
    },
    "node.uninstall_details %@" : {
      "comment" : "{version}: the major",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odeberou se i jeho globální balíčky npm. Projekty a weby, které používají Node %@, budou používat výchozí verzi, dokud ho znovu nenainstalujete."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its global npm packages are removed too. Projects and sites that use Node %@ fall back to the default version until you install it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También se quitan sus paquetes globales de npm. Los proyectos y sitios que usan Node %@ vuelven a la versión predeterminada hasta que lo instales de nuevo."
          }
        }
      }
    },
