    "about.uninstall_keeps %@" : {
      "comment" : "{0}: the data folder",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení vašich webů a databáze PostgreSQL a Redis zůstanou v %@, takže po přeinstalaci navážete, kde jste skončili — pokud je také nesmažete:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sites' settings and your PostgreSQL and Redis databases stay in %@, so reinstalling picks up where you left off — unless you also delete them:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de tus sitios y tus bases de datos de PostgreSQL y Redis se conservan en %@, así que al reinstalar continúas donde lo dejaste, salvo que también los elimines:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройки ваших сайтов и ваши базы данных PostgreSQL и Redis остаются в %@, поэтому после переустановки вы продолжите с того места, где остановились, — если только вы также не удалите их:"
          }
        }
      }
    },
