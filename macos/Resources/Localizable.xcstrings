    "Flock runs your Laravel sites, PHP, mail and databases on this Mac. Setting it up takes a moment:" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock na tomto Macu provozuje vaše weby v Laravelu, PHP, poštu a databáze. Nastavení zabere jen chvilku:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock ejecuta en este Mac tus sitios Laravel, PHP, el correo y las bases de datos. Configurarlo lleva un momento:"
          }
        }
      }
    },
    "Flock serves <name>.%@ from a server of its own, e.g. a Next.js, Nuxt or Vite dev server. A port means 127.0.0.1." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock bude poskytovat <název>.%@ z vlastního serveru, např. vývojového serveru Next.js, Nuxt nebo Vite. Samotný port znamená 127.0.0.1."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock sirve <nombre>.%@ desde un servidor propio, p. ej. un servidor de desarrollo de Next.js, Nuxt o Vite. Un puerto solo significa 127.0.0.1."
          }
        }
      }
    },
    "Flock serves the first of public/, www/, web/ and webroot/ with an index.php, else the project folder." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock použije první ze složek public/, www/, web/ a webroot/, která obsahuje index.php, jinak složku projektu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock sirve la primera de public/, www/, web/ y webroot/ que tenga un index.php; si no, la carpeta del proyecto."
          }
        }
      }
    },
    "Flock Settings" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení Flocku"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes de Flock"
          }
        }
      }
    },
    "Flock stops and is removed from your PATH, together with its PHP and Node.js versions, certificates, logs and caches. macOS asks for your password to remove the *.test DNS setup and Flock's trusted certificate. Then this app moves itself to the Trash." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock se zastaví a odebere se z PATH spolu se svými verzemi PHP a Node.js, certifikáty, logy a cache. macOS si vyžádá heslo, aby mohl odebrat nastavení DNS pro *.test a důvěryhodný certifikát Flocku. Pak se tato aplikace přesune do Koše."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock se detiene y se quita de tu PATH, junto con sus versiones de PHP y Node.js, certificados, registros y cachés. macOS te pide la contraseña para quitar la configuración DNS de *.test y el certificado de confianza de Flock. Después, esta app se mueve a la Papelera."
          }
        }
      }
    },
    "Flock stops serving %@. The project in %@ is not touched." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock přestane poskytovat %1$@. Projektu v %2$@ se nic nestane."
