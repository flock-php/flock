    "sites.require_tooltip %@ %@" : {
      "comment" : "{name}: the extension, {path}: the project folder",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spustí composer require ext-%1$@:* ve složce %2$@, což změní composer.json a composer.lock. Commitněte je s projektem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs composer require ext-%1$@:* in %2$@, which changes composer.json and composer.lock. Commit them with the project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta composer require ext-%1$@:* en %2$@, lo que cambia composer.json y composer.lock. Haz commit de ambos con el proyecto."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ içinde composer require ext-%1$@:* komutunu çalıştırır; bu, composer.json ve composer.lock dosyalarını değiştirir. Bunları projeyle birlikte commit edin."
          }
        }
      }
    },
    "sites.restart_frankenphp_tooltip" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restartovat FrankenPHP, např. aby workery Octane načetly změněný kód"
          }
        },
        "en" : {
