    "%@ couldn't be installed" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se nepodařilo nainstalovat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo instalar %@"
          }
        }
      }
    },
    "%@ exists, so the worktree checks it out. Flock creates it next to %@, sets it up and serves it at %@." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Větev %1$@ už existuje, takže ji worktree použije. Flock ho vytvoří vedle webu %2$@, připraví ho a bude ho poskytovat na adrese %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ya existe, así que el worktree la usa. Flock lo crea junto a %2$@, lo prepara y lo sirve en %3$@."
          }
        }
      }
    },
    "%@ for PostgreSQL %@, where they're available for it. You can change this later under Extensions…." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ pro PostgreSQL %2$@, pokud jsou pro něj k dispozici. Později to můžete změnit v Rozšířeních…."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ para PostgreSQL %2$@, donde estén disponibles. Puedes cambiarlo más tarde en Extensiones…."
          }
        }
      }
    },
    "%@ has no index.php or index.html, so Flock shows a page instead of the site until it does." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ neobsahuje index.php ani index.html, takže Flock místo webu zobrazuje informační stránku, dokud tam nebudou."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no tiene index.php ni index.html, así que Flock muestra una página en lugar del sitio hasta que los tenga."
          }
        }
      }
    },
