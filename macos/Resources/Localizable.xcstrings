    "sites.reverb.explanation %@" : {
      "comment" : "{address}: the WebSocket address, e.g. wss://app.test/app",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock pro web spouští php artisan reverb:start. Prohlížeče se k němu připojí na %@, bez vlastního portu či certifikátu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock runs php artisan reverb:start for the site. Browsers reach it at %@, with no port or certificate of its own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock ejecuta php artisan reverb:start para el sitio. Los navegadores lo alcanzan en %@, sin puerto ni certificado propios."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock, site için php artisan reverb:start komutunu çalıştırır. Tarayıcılar ona %@ adresinden, kendine ait bir port veya sertifika olmadan ulaşır."
          }
        }
      }
    },
    "sites.reverb.footnote" : {
      "comment" : "/app and /apps are paths of the site's address",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojení WebSocket pod /app a broadcasty Laravelu pod /apps jdou do Reverbu; všechny ostatní požadavky zůstávají aplikaci. Flock soubor .env projektu nemění. Po jeho změně znovu sestavte front-end."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebSocket connections under /app and Laravel's broadcasts under /apps go to Reverb; every other request stays the app's. Flock doesn't change the project's .env. Rebuild the front end after changing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las conexiones WebSocket bajo /app y las difusiones de Laravel bajo /apps van a Reverb; el resto de solicitudes siguen yendo a la app. Flock no cambia el .env del proyecto. Vuelve a compilar el front-end después de cambiarlo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "/app altındaki WebSocket bağlantıları ve /apps altındaki Laravel yayınları Reverb'e gider; diğer tüm istekler uygulamada kalır. Flock projenin .env dosyasını değiştirmez. Değiştirdikten sonra ön yüzü yeniden derleyin."
          }
        }
      }
    },
    "sites.reverb.install" : {
      "localizations" : {
        "cs" : {
