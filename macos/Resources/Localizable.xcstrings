    "sites.frankenphp_needs_php_8_2" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP vyžaduje PHP 8.2 nebo novější. Požadavky, které chtějí Xdebug, dál obsluhuje PHP-FPM."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP needs PHP 8.2 or newer. Requests that ask for Xdebug still go to PHP-FPM."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP necesita PHP 8.2 o posterior. Las solicitudes que piden Xdebug siguen yendo a PHP-FPM."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP, PHP 8.2 veya daha yenisini gerektirir. Xdebug isteyen istekler yine PHP-FPM'e gider."
          }
        }
      }
    },
    "sites.frankenphp_needs_php_8_2_or" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP vyžaduje PHP 8.2 nebo novější. Požadavky, které chtějí Xdebug, dál obsluhuje PHP-FPM. Pro režim workerů nainstalujte do projektu Laravel Octane (composer require laravel/octane)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP needs PHP 8.2 or newer. Requests that ask for Xdebug still go to PHP-FPM. For worker mode, install Laravel Octane in the project (composer require laravel/octane)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP necesita PHP 8.2 o posterior. Las solicitudes que piden Xdebug siguen yendo a PHP-FPM. Para el modo worker, instala Laravel Octane en el proyecto (composer require laravel/octane)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FrankenPHP, PHP 8.2 veya daha yenisini gerektirir. Xdebug isteyen istekler yine PHP-FPM'e gider. Worker modu için projeye Laravel Octane yükleyin (composer require laravel/octane)."
          }
        }
      }
    },
