    "sites.removes_root_from_flockrc_in %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebere root= z .flockrc ve složce %@. Flock pak kořenovou složku najde sám. Tím se změní soubory ve vašem projektu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes root= from .flockrc in %@. Flock then finds the document root itself. This changes files in your project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita root= de .flockrc en %@. Flock buscará entonces la raíz de documentos por sí mismo. Esto cambia archivos de tu proyecto."
          }
        }
      }
    },
    "sites.removes_the_node_js_version %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebere verzi Node.js z .flockrc a smaže .nvmrc / .node-version ve složce %@. Web pak použije výchozí Node.js Flocku. Tím se změní soubory ve vašem projektu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the Node.js version from .flockrc and deletes .nvmrc / .node-version in %@. The site then uses Flock's default Node.js. This changes files in your project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita la versión de Node.js de .flockrc y elimina .nvmrc / .node-version en %@. Después, el sitio usa el Node.js predeterminado de Flock. Esto cambia archivos de tu proyecto."
          }
        }
      }
    },
