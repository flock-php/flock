    "services.postgres.psql_pg_dump_and_the" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump a další nástroje příkazové řádky jsou součástí PostgreSQL. V Terminálu Flock používá ty z nejnovější nainstalované verze, které fungují se všemi verzemi výše i se vzdálenými servery."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump and the other command-line tools come with PostgreSQL. In Terminal, Flock uses those of the newest installed version, which work with every version above and with remote servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump y las demás herramientas de línea de comandos vienen con PostgreSQL. En Terminal, Flock usa las de la versión instalada más reciente, que funcionan con todas las versiones de arriba y con servidores remotos."
