    "sites.writes_ai_guidelines_flock_md %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapíše .ai/guidelines/flock.md do %@ a spustí php artisan boost:update, aby AI agenti věděli, že aplikaci obsluhuje Flock a vybírá její verzi PHP. Commitněte ho se zbytkem .ai/guidelines. Tím se změní soubory ve vašem projektu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes .ai/guidelines/flock.md in %@ and runs php artisan boost:update, so AI agents know Flock serves the app and picks its PHP version. Commit it with the rest of .ai/guidelines. This changes files in your project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe .ai/guidelines/flock.md en %@ y ejecuta php artisan boost:update para que los agentes de IA sepan que Flock sirve la app y elige su versión de PHP. Haz commit junto con el resto de .ai/guidelines. Esto cambia archivos de tu proyecto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает .ai/guidelines/flock.md в %@ и запускает php artisan boost:update, чтобы ИИ-агенты знали, что Flock обслуживает приложение и выбирает его версию PHP. Закоммитьте это вместе с остальной частью .ai/guidelines. Это изменяет файлы в вашем проекте."
          }
        }
      }
    },
    "sites.writes_php_version_to_flockrc %@ %@ %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapíše php=%1$@ do .flockrc ve složce %2$@. Commitněte ho a každý, kdo na tomto projektu používá Flock, dostane PHP %3$@. Tím se změní soubor ve vašem projektu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes php=%1$@ to .flockrc in %2$@. Commit it, and everyone using Flock on this project gets PHP %3$@. This changes a file in your project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe php=%1$@ en .flockrc en %2$@. Haz commit y todos los que usen Flock en este proyecto tendrán PHP %3$@. Esto cambia un archivo de tu proyecto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает php=%1$@ в .flockrc в %2$@. Закоммитьте это, и каждый, кто использует Flock в этом проекте, получит PHP %3$@. Это изменяет файл в вашем проекте."
          }
        }
      }
    },
    "sites.writes_root_value_to_flockrc %@ %@ %@" : {
