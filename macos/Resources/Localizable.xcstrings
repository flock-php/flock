    "sites.every_subdomain_up_to_levels %lld %@" : {
      "localizations" : {
        "cs" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Každá subdoména až %1$lld úrovně pod webem už funguje. Pro alias přidejte celé jméno jako %2$@, nebo přidejte subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez zástupného DNS."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Každá subdoména až %1$lld úrovně pod webem už funguje. Pro alias přidejte celé jméno jako %2$@, nebo přidejte subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez zástupného DNS."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Každá subdoména až %1$lld úroveň pod webem už funguje. Pro alias přidejte celé jméno jako %2$@, nebo přidejte subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez zástupného DNS."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Každá subdoména až %1$lld úrovní pod webem už funguje. Pro alias přidejte celé jméno jako %2$@, nebo přidejte subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez zástupného DNS."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Every subdomain up to %1$lld level below the site already works. Add a full name like %2$@ for an alias, or a subdomain (tenant1, a.b) so it is listed here and also resolves on Windows machines without wildcard DNS."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Every subdomain up to %1$lld levels below the site already works. Add a full name like %2$@ for an alias, or a subdomain (tenant1, a.b) so it is listed here and also resolves on Windows machines without wildcard DNS."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
