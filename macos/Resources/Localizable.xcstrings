    "services.postgres.postgresql_version_stops_and_flock %@ %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %1$@ se zastaví a Flock se přepne na PostgreSQL %2$@ s jeho vlastními databázemi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %1$@ stops and Flock switches to PostgreSQL %2$@ with its own databases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %1$@ se detiene y Flock cambia a PostgreSQL %2$@ con sus propias bases de datos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %1$@ durur ve Flock, kendi veritabanlarına sahip PostgreSQL %2$@ sürümüne geçer."
          }
        }
      }
    },
    "services.postgres.postgresql_version_stops_and_your %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %@ se zastaví a vaše weby nebudou moci PostgreSQL používat, dokud znovu nenainstalujete některou verzi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %@ stops, and your sites can't use PostgreSQL until you install a version again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %@ se detiene y tus sitios no podrán usar PostgreSQL hasta que vuelvas a instalar una versión."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
