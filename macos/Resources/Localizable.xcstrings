      }
    },
    "services.postgres.psql_pg_dump_and_the" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump a další nástroje příkazové řádky jsou součástí PostgreSQL. V Terminálu Flock používá ty z nejnovější nainstalované verze, které fungují se všemi verzemi výše i se vzdálenými servery."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump and the other command-line tools come with PostgreSQL. In Terminal, Flock uses those of the newest installed version, which work with every version above and with remote servers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump y las demás herramientas de línea de comandos vienen con PostgreSQL. En Terminal, Flock usa las de la versión instalada más reciente, que funcionan con todas las versiones de arriba y con servidores remotos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "psql, pg_dump ve diğer komut satırı araçları PostgreSQL ile birlikte gelir. Terminal'de Flock, yüklü en yeni sürümün araçlarını kullanır; bunlar yukarıdaki tüm sürümlerle ve uzak sunucularla çalışır."
          }
        }
      }
    },
    "services.postgres.removes_the_postgresql_version_server %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odebere server PostgreSQL %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes the PostgreSQL %@ server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita el servidor PostgreSQL %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostgreSQL %@ sunucusunu kaldırır."
          }
        }
      }
    },
    "services.postgres.side_by_side" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nainstalované verze zůstávají vedle sebe. Běží vždy jen jedna; každá má vlastní databáze, které zůstanou zachovány i při aktualizacích v rámci verze."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installed versions stay side by side. One runs at a time; each keeps its own databases, and updates within a version keep them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las versiones instaladas conviven. Solo se ejecuta una a la vez; cada una tiene sus propias bases de datos, y las actualizaciones dentro de una versión las conservan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü sürümler yan yana durur. Aynı anda yalnızca biri çalışır; her biri kendi veritabanlarını korur ve bir sürüm içindeki güncellemeler de bunları korur."
          }
        }
      }
    },
