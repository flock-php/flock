    "debugger.set_a_breakpoint_in_phpstorm" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte breakpoint v PhpStormu a zapněte naslouchání ladicím připojením, použijte rozšíření prohlížeče pro Xdebug, nebo přidejte k URL `?XDEBUG_TRIGGER=1`. Na příkazové řádce spusťte `flock debug artisan …`."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a breakpoint in PhpStorm and listen for debug connections, use the Xdebug browser extension, or add `?XDEBUG_TRIGGER=1` to the URL. On the command line, run `flock debug artisan …`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon un punto de interrupción en PhpStorm y escucha las conexiones de depuración, usa la extensión de Xdebug para el navegador o añade `?XDEBUG_TRIGGER=1` a la URL. En la línea de comandos, ejecuta `flock debug artisan …`."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PhpStorm'da bir breakpoint koyup debug bağlantılarını dinleyin, Xdebug tarayıcı eklentisini kullanın veya URL'ye `?XDEBUG_TRIGGER=1` ekleyin. Komut satırında `flock debug artisan …` komutunu çalıştırın."
          }
        }
      }
    },
