    "services.macos_sends_every_name_under %@ %@ %@ %@" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sem posílá každé jméno pod .%1$@ (/etc/resolver/%2$@, nastavuje `flock install`), takže libovolná subdoména webu funguje (tenant1.app.%3$@, a.b.app.%4$@), aniž byste ji museli přidávat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sends every name under .%1$@ here (/etc/resolver/%2$@, set up by `flock install`), so any subdomain of a site works (tenant1.app.%3$@, a.b.app.%4$@) without adding it."
          }
        },
        "es" : {
