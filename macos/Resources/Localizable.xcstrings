    "sites.proxy.command_help" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock spustí spouštěcí příkaz, když kliknete na Spustit, a zobrazí jeho výstup. U příkazu, který spouští server na pozadí, jako docker compose up -d, přidejte příkaz, který ho zastaví."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock runs the start command when you click Start and shows its output. For a command that starts the server in the background, like docker compose up -d, add the command that stops it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flock ejecuta el comando de inicio cuando haces clic en Iniciar y muestra su salida. Para un comando que inicia el servidor en segundo plano, como docker compose up -d, añade el comando que lo detiene."
          }
        }
      }
    },
