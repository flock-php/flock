# What linux/packaging/postinstall.sh and preremove.sh do for the .deb and .rpm, minus the package
# repository: pacman's own hooks reload systemd and refresh the icon and desktop caches.

post_install() {
  echo 'Flock is installed. Set it up for your user with: flk install'
}

# Every running daemon restarts and runs the new flock through the link `flk install` put in the
# user's data dir.
post_upgrade() {
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    systemctl try-restart 'flock@*.service' || true
  fi
}

# Every user's daemon is stopped and their system-wide setup undone (unit drop-in, *.test DNS, CA
# trust, Firefox policy). Users' own files stay: `flock uninstall` removes those.
pre_remove() {
  for dir in /etc/systemd/system/flock@?*.service.d; do
    [ -d "$dir" ] || continue
    user="${dir#/etc/systemd/system/flock@}"
    user="${user%.service.d}"
    /usr/libexec/flockphp/flock privileged-setup --remove --user "$user" || echo "flockphp: could not undo Flock's setup for $user" >&2
  done
}
