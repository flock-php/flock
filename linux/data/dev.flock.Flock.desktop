[Desktop Entry]
Type=Application
Name=Flock
GenericName=Local Development Environment
GenericName[cs]=Lokální vývojové prostředí
GenericName[es]=Entorno de desarrollo local
Comment=Sites, PHP, Node.js and services for local development
Comment[cs]=Weby, PHP, Node.js a služby pro lokální vývoj
Comment[es]=Sitios, PHP, Node.js y servicios para el desarrollo local
Exec=/usr/libexec/flockphp/flock-app %u
Icon=dev.flock.Flock
Terminal=false
Categories=Development;
Keywords=php;laravel;node;server;dev;
Keywords[cs]=php;laravel;node;server;vývoj;web;
Keywords[es]=php;laravel;node;servidor;desarrollo;web;
StartupNotify=true
StartupWMClass=dev.flock.Flock
MimeType=x-scheme-handler/flock;
