msgstr "El Node {pinned} de .flockrc tiene prioridad sobre {other}."

#. What a proxy's upstream can be
msgid "3000, host:port or URL. A port means 127.0.0.1."
msgstr "3000, host:puerto o URL. Un puerto solo significa 127.0.0.1."

msgid "A copy of the site's"
msgstr "Una copia de la del sitio"

msgid "A database of its own gets the branch's migrations run on it."
msgstr "En una base de datos propia se ejecutan las migraciones de la rama."

#. {name}: the name, {version}: the version, {purpose}: what it is for
msgid "A link asked Flock to install {name} {version}. {purpose}"
msgstr "Un enlace pidió a Flock instalar {name} {version}. {purpose}"

#. {domain}: the site's domain
msgid "A link asked Flock to secure {domain}. It gets a certificate this computer already trusts."
msgstr "Un enlace pidió a Flock proteger {domain}. Recibirá un certificado en el que este equipo ya confía."

msgid "A native local development environment for Laravel."
msgstr "Un entorno de desarrollo local nativo para Laravel."

msgid "A new build is available"
msgstr "Hay una nueva compilación disponible"

msgid "A new, empty one"
msgstr "Una nueva y vacía"

msgid "A port between 1024 and 65535 that no other program uses."
msgstr "Un puerto entre 1024 y 65535 que no use ningún otro programa."

msgid "A port means 127.0.0.1; give a host and port (localhost:5173) or a URL (https://127.0.0.1:8443) for anything else."
msgstr "Un puerto solo significa 127.0.0.1; para cualquier otra cosa, indica un host y un puerto (localhost:5173) o una URL (https://127.0.0.1:8443)."

msgid "A version picked here applies on this machine only. To set it for everyone working on the project, pin it: PHP goes into .flockrc, Node.js into .nvmrc."
msgstr "La versión que elijas aquí solo se aplica en este equipo. Para definirla para todos los que trabajan en el proyecto, fíjala: PHP va a .flockrc y Node.js a .nvmrc."

