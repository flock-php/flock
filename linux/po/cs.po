msgstr "{name} {version} začne s prázdnými daty."

msgid "{name} {version} stops and {name} {next} becomes the active version."
msgstr "{name} {version} se zastaví a aktivní verzí se stane {name} {next}."

msgid "{name} {version} stops; its data stays but isn't used until you switch back. {then}"
msgstr "{name} {version} se zastaví; jeho data zůstanou, ale nepoužijí se, dokud se nepřepnete zpět. {then}"

msgid "{name} {version} stops; your sites can't use {name} until you install a version again."
msgstr "{name} {version} se zastaví; vaše weby nebudou moci {name} používat, dokud znovu nenainstalujete některou verzi."

msgid "{name} {version} uses its own data."
msgstr "{name} {version} používá vlastní data."

