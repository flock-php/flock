msgstr "{port} · nastavil `flock install`"

msgid "{problem} Settings → General has it too."
msgstr "{problem} Najdete to také v Nastavení → Obecné."

msgid "{program} uses {ports}."
msgstr "{program} používá {ports}."

#. {root}: the folder
msgid "{root} has no index.php or index.html, so Flock shows a page instead of the site until it does."
msgstr "{root} neobsahuje index.php ani index.html, takže Flock místo webu zobrazuje informační stránku, dokud tam nebudou."

#. {root}: the folder set here, {pinned}: the project's
msgid "{root} is set here; the project sets {pinned} in .flockrc."
msgstr "Zde je nastaveno {root}; projekt v .flockrc nastavuje {pinned}."

msgid "{service} Port"
msgstr "Port služby {service}"

#. {site}: the site
msgid "{site} is already secured"
msgstr "Web {site} už je zabezpečený"

msgid "{tool} {version} is set for this site on this machine (isolated)."
msgstr "Pro tento web je na tomto počítači nastavena verze {tool} {version} (izolovaně)."

msgid "{worktree} then uses {site}'s database."
msgstr "{worktree} pak bude používat databázi webu {site}."
