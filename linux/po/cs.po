msgid "Every captured dump, query, log, view and job is deleted, from all requests and commands."
msgstr "Smažou se všechny zachycené dumpy, dotazy, logy, pohledy a úlohy ze všech požadavků a příkazů."

#. {tld}: the TLD ("test")
msgid "Every folder inside a project folder is served as <folder>.{tld} — the same as `flock park`."
msgstr "Každá složka uvnitř složky projektů se obsluhuje jako <složka>.{tld} — stejně jako po `flock park`."

msgid "Every installed version runs its own PHP-FPM pool. Sites use the default unless pinned to a version."
msgstr "Každá nainstalovaná verze má vlastní PHP-FPM pool. Weby používají výchozí verzi, pokud nemají připnutou jinou."

msgid "Every name, any subdomain included, is resolved by Flock's DNS server through systemd-resolved."
msgstr "Každý název včetně libovolné subdomény překládá DNS server Flocku přes systemd-resolved."

#. {domain}: the domain
msgid "Every request passes to the upstream with its Host header, WebSocket upgrades (hot reload) included. Flock doesn't start the server, so start it as usual. Until it answers, {domain} shows a page saying so."
msgstr "Každý požadavek se předá cíli i s hlavičkou Host, včetně přechodu na WebSocket (hot reload). Flock server nespouští, takže ho spusťte jako obvykle. Dokud neodpovídá, {domain} zobrazuje stránku s touto informací."

msgid "Every service Flock offers: MySQL, Redis, Meilisearch and more"
msgstr "Všechny služby, které Flock nabízí: MySQL, Redis, Meilisearch a další"

msgid "Every subdomain up to {n} level below the site already works. Add a full name like {site}-2.{tld} for an alias, or a subdomain (tenant1, a.b) so it is listed here and also resolves on Windows machines without wildcard DNS."
msgid_plural "Every subdomain up to {n} levels below the site already works. Add a full name like {site}-2.{tld} for an alias, or a subdomain (tenant1, a.b) so it is listed here and also resolves on Windows machines without wildcard DNS."
msgstr[0] "Každá subdoména až {n} úroveň pod webem už funguje. Pro alias přidejte celý název jako {site}-2.{tld}, nebo subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez wildcard DNS."
msgstr[1] "Každá subdoména až {n} úrovně pod webem už funguje. Pro alias přidejte celý název jako {site}-2.{tld}, nebo subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez wildcard DNS."
msgstr[2] "Každá subdoména až {n} úrovní pod webem už funguje. Pro alias přidejte celý název jako {site}-2.{tld}, nebo subdoménu (tenant1, a.b), aby byla uvedená zde a překládala se i na počítačích s Windows bez wildcard DNS."

msgid "Experimental channel: packages that aren’t released yet are offered. `flock channel stable` switches back."
msgstr "Experimentální kanál: nabízí se i dosud nevydané balíčky. Zpět přepnete příkazem `flock channel stable`."

msgid "Extensions folder"
msgstr "Složka rozšíření"

msgid "Extensions of PostgreSQL {version}: PostGIS, pgRouting, pgvector, TimescaleDB and your own"
msgstr "Rozšíření PostgreSQL {version}: PostGIS, pgRouting, pgvector, TimescaleDB a vaše vlastní"

msgid "Extra domains: subdomains and aliases"
msgstr "Další domény: subdomény a aliasy"

