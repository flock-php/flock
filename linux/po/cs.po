msgid "Unpin PHP ({file})…"
msgstr "Odepnout PHP ({file})…"

#: src/panes/sites.rs
msgid "Unpin PHP from {site}?"
msgstr "Odepnout PHP od webu {site}?"

#: src/panes/sites.rs
msgid "Removes the PHP version from {file}. The site then uses Flock's default PHP. This changes files in your project."
msgstr "Odebere verzi PHP z {file}. Web pak použije výchozí PHP Flocku. Tím se změní soubory ve vašem projektu."

#: src/panes/sites.rs
msgid "Unpin Node ({file})…"
msgstr "Odepnout Node ({file})…"

#: src/panes/sites.rs
msgid "Unpin Node from {site}?"
msgstr "Odepnout Node od webu {site}?"

#: src/panes/sites.rs
msgid "Removes the Node.js version from .flockrc and deletes .nvmrc / .node-version in {path}. The site then uses Flock's default Node.js. This changes files in your project."
msgstr "Odebere verzi Node.js z .flockrc a smaže .nvmrc / .node-version ve složce {path}. Web pak použije výchozí Node.js Flocku. Tím se změní soubory ve vašem projektu."

