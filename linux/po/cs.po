msgid "Flock answered with HTTP {status}"
msgstr "Flock odpověděl kódem HTTP {status}"

msgid "Flock can't run it on this platform."
msgstr "Flock ho na této platformě nedokáže spustit."

msgid "Flock can't run this service here."
msgstr "Flock tuto službu nemůže spustit zde."

msgid "Flock catches every email your apps send — nothing leaves your computer."
msgstr "Flock zachytí každý e-mail, který vaše aplikace odešlou — nic neopustí váš počítač."

msgid "Flock copies {site}'s database and runs the branch's migrations on it."
msgstr "Flock zkopíruje databázi webu {site} a spustí v ní migrace větve."

msgid "Flock creates an empty database and runs the migrations."
msgstr "Flock vytvoří prázdnou databázi a spustí migrace."

#. {site}: the site
msgid "Flock creates the worktree next to {site} on a new branch with a name of its own, sets it up and serves it at its own address."
msgstr "Flock vytvoří worktree vedle webu {site} na nové větvi s vlastním názvem, připraví ho a bude ho obsluhovat na vlastní adrese."

#. {branch}: the branch, {site}: the site, {address}: the address
msgid "Flock creates the worktree next to {site} on the new branch {branch}, sets it up and serves it at {address}."
msgstr "Flock vytvoří worktree vedle webu {site} na nové větvi {branch}, připraví ho a bude ho obsluhovat na {address}."

#. {name}: the service, with the version when the link names one
msgid "Flock doesn't offer {name}"
msgstr "Flock nenabízí {name}"

msgid "Flock doesn't offer {name} {version}"
msgstr "Flock nenabízí {name} {version}"

#. {site}: the site
msgid "Flock has no site called {site}"
msgstr "Flock nemá web s názvem {site}"

msgid "Flock hasn't set this worktree up"
msgstr "Flock tento worktree nepřipravil"

msgid "Flock is added"
msgstr "Flock je přidán"

msgid "Flock is free and open source, forever. Sponsoring helps keep it maintained."
msgstr "Flock je zdarma a open source, navždy. Sponzorství pomáhá udržet jeho vývoj."

#. Keep the Markdown link: [label](url)
msgid "Flock is free and open source. If you like it, [a star on GitHub](https://github.com/flock-php/flock) helps others find it."
msgstr "Flock je zdarma a open source. Pokud se vám líbí, [hvězdička na GitHubu](https://github.com/flock-php/flock) pomůže ostatním ho najít."

msgid "Flock is not installed for this user ({path} is missing) — run `flk install` once."
msgstr "Flock není pro tohoto uživatele nainstalovaný (chybí {path}) — spusťte jednou `flk install`."

msgid "Flock is not running"
msgstr "Flock neběží"

msgid "Flock is ready"
msgstr "Flock je připravený"

msgid "Flock isn't installed: install the flockphp package first."
msgstr "Flock není nainstalovaný: nejdřív nainstalujte balíček flockphp."

msgid "Flock makes it the default for your sites and terminal."
msgid_plural "Flock makes them the default for your sites and terminal."
msgstr[0] "Flock ho nastaví jako výchozí pro vaše weby a terminál."
msgstr[1] "Flock je nastaví jako výchozí pro vaše weby a terminál."
msgstr[2] "Flock je nastaví jako výchozí pro vaše weby a terminál."

msgid "Flock needs these ports and *.{tld} for itself, but other programs use them. Running both would leave neither working."
msgstr "Flock potřebuje tyto porty a *.{tld} pro sebe, ale používají je jiné programy. Pokud by běželo obojí, nefungovalo by ani jedno."

#. {path}: the folder, {database}: the database
msgid "Flock runs its before_delete hook and deletes {path} and its database {database}."
msgstr "Flock spustí jeho hook before_delete a smaže {path} i jeho databázi {database}."

#. {path}: the folder
msgid "Flock runs its before_delete hook and deletes {path}."
msgstr "Flock spustí jeho hook before_delete a smaže {path}."

msgid "Flock runs your Laravel sites, PHP, mail and databases on this computer. Setting it up takes a moment:"
msgstr "Flock na tomto počítači provozuje vaše weby v Laravelu, PHP, poštu a databáze. Nastavení chvíli potrvá:"

#. {tld}: the TLD
msgid "Flock serves <name>.{tld} from a server of its own, e.g. a Next.js, Nuxt or Vite dev server. A port means 127.0.0.1."
